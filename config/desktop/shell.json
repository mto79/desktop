{
  "version": 1,
  "launcher": {
    "width": 520,
    "maxResults": 8
  },
  "notifications": {
    "position": "top-right",
    "margin": 12,
    "width": 380,
    "maxVisible": 5
  },
  "osd": {
    "position": "bottom",
    "margin": 80,
    "timeout": 1500
  },
  "bar": {
    "position": "top",
    "height": 38,
    "transparent": false,
    "centerAnchor": "clock",
    "layout": {
      "left": [
        {
          "id": "menu"
        },
        {
          "id": "spacer"
        },
        {
          "id": "workspaces"
        },
        {
          "id": "spacer"
        },
        {
          "id": "window"
        }
      ],
      "center": [
        {
          "id": "media"
        },
        {
          "id": "spacer"
        },
        {
          "id": "clock",
          "format": "ddd dd HH:mm",
          "firstDay": "monday"
        },
        {
          "id": "spacer"
        },
        {
          "id": "monitors",
          "type": "command",
          "exec": "desktop-status-monitors",
          "interval": 10,
          "icon": "󰍹",
          "hideWhenEmpty": false,
          "colors": {
            "laptop": "muted",
            "unknown": "urgent"
          },
          "onClick": "desktop-menu monitors"
        },
        {
          "id": "toggles"
        },
        {
          "id": "update"
        }
      ],
      "right": [
        {
          "id": "tray",
          "glyphs": {
            "KeePassXC": "",
            "remmina-icon": "",
            "Fcitx": "",
            "nm-applet": ""
          },
          "commands": {
            "remmina-icon": "remmina"
          }
        },
        {
          "id": "spacer"
        },
        {
          "id": "bluetooth"
        },
        {
          "id": "vpn"
        },
        {
          "id": "network"
        },
        {
          "id": "spacer"
        },
        {
          "id": "audio"
        },
        {
          "id": "microphone"
        },
        {
          "id": "spacer"
        },
        {
          "id": "ai",
          "type": "command",
          "exec": "desktop-status-ai",
          "interval": 15,
          "icon": "󰚩",
          "colors": {
            "critical": "urgent",
            "warning": "accent",
            "busy": "accent",
            "active": "muted"
          },
          "panel": "ai",
          "onRightClick": "desktop-menu agents"
        },
        {
          "id": "camera",
          "type": "command",
          "exec": "desktop-status-camera",
          "interval": 3,
          "icon": "",
          "colors": {
            "on": "urgent"
          },
          "onClick": "desktop-menu camera"
        },
        {
          "id": "spacer"
        },
        {
          "id": "backup",
          "type": "command",
          "exec": "desktop-backup status --bar",
          "interval": 300,
          "icon": "󰅧",
          "hideWhenEmpty": false,
          "colors": {
            "stale": "urgent",
            "never": "urgent",
            "running": "accent",
            "unconfigured": "accent",
            "unreachable": "muted"
          },
          "panel": "backup"
        },
        {
          "id": "spacer"
        },
        {
          "id": "disk",
          "path": "/"
        },
        {
          "id": "memory"
        },
        {
          "id": "cpu"
        },
        {
          "id": "battery"
        }
      ]
    }
  }
}
