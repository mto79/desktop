{
  "version": 1,
  "osd": {
    "position": "bottom",
    "margin": 80,
    "timeout": 1500
  },
  "bar": {
    "position": "top",
    "height": 38,
    "transparent": false,
    "centerAnchor": "clock",
    "layout": {
      "left": [
        { "id": "menu" },
        { "id": "workspaces" },
        { "id": "window" }
      ],
      "center": [
        { "id": "media" },
        { "id": "clock", "format": "ddd dd HH:mm:ss", "firstDay": "monday" },
        { "id": "update" },
        { "id": "screenrecording" }
      ],
      "right": [
        { "id": "tray" },
        { "id": "bluetooth" },
        { "id": "vpn" },
        { "id": "network" },
        { "id": "audio" },
        { "id": "microphone" },
        { "id": "disk", "path": "/" },
        { "id": "memory" },
        { "id": "cpu" },
        { "id": "battery" }
      ]
    }
  }
}
