{
  "version": 1,
  "launcher": {
    "width": 520,
    "maxResults": 8
  },
  "notifications": {
    "position": "top-right",
    "margin": 12,
    "width": 380,
    "maxVisible": 5
  },
  "osd": {
    "position": "bottom",
    "margin": 80,
    "timeout": 1500
  },
  "bar": {
    "position": "top",
    "height": 38,
    "transparent": false,
    "centerAnchor": "clock",
    "layout": {
      "left": [
        {
          "id": "menu"
        },
        {
          "id": "spacer"
        },
        {
          "id": "workspaces"
        },
        {
          "id": "spacer"
        },
        {
          "id": "window"
        }
      ],
      "center": [
        {
          "id": "media"
        },
        {
          "id": "spacer"
        },
        {
          "id": "clock",
          "format": "ddd dd HH:mm:ss",
          "firstDay": "monday"
        },
        {
          "id": "spacer"
        },
        {
          "id": "update"
        },
        {
          "id": "screenrecording"
        }
      ],
      "right": [
        {
          "id": "tray",
          "glyphs": {
            "KeePassXC": "",
            "remmina-icon": "",
            "Fcitx": "",
            "nm-applet": ""
          },
          "commands": {
            "remmina-icon": "remmina"
          }
        },
        {
          "id": "spacer"
        },
        {
          "id": "bluetooth"
        },
        {
          "id": "vpn"
        },
        {
          "id": "network"
        },
        {
          "id": "spacer"
        },
        {
          "id": "audio"
        },
        {
          "id": "microphone"
        },
        {
          "id": "spacer"
        },
        {
          "id": "ai",
          "type": "command",
          "exec": "desktop-status-ai",
          "interval": 15,
          "icon": "󰚩",
          "colors": {
            "busy": "accent",
            "active": "muted"
          },
          "onClick": "desktop-menu agents"
        },
        {
          "id": "camera",
          "type": "command",
          "exec": "desktop-status-camera",
          "interval": 3,
          "icon": "",
          "colors": {
            "on": "urgent"
          },
          "onClick": "desktop-menu camera"
        },
        {
          "id": "voxtype",
          "type": "command",
          "exec": "desktop-status-voxtype",
          "follow": true,
          "icon": "",
          "colors": {
            "recording": "urgent",
            "transcribing": "accent"
          },
          "onClick": "voxtype record toggle"
        },
        {
          "id": "spacer"
        },
        {
          "id": "disk",
          "path": "/"
        },
        {
          "id": "memory"
        },
        {
          "id": "cpu"
        },
        {
          "id": "battery"
        }
      ]
    }
  }
}
