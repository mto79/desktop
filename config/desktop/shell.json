{
  "version": 1,
  "launcher": {
    "width": 520,
    "maxResults": 8
  },
  "notifications": {
    "position": "top-right",
    "margin": 12,
    "width": 380,
    "maxVisible": 5
  },
  "osd": {
    "position": "bottom",
    "margin": 80,
    "timeout": 1500
  },
  "bar": {
    "position": "top",
    "height": 38,
    "transparent": false,
    "centerAnchor": "clock",
    "layout": {
      "left": [
        {
          "id": "menu"
        },
        {
          "id": "spacer"
        },
        {
          "id": "workspaces"
        },
        {
          "id": "spacer"
        },
        {
          "id": "window"
        }
      ],
      "center": [
        {
          "id": "media"
        },
        {
          "id": "spacer"
        },
        {
          "id": "toggles"
        },
        {
          "id": "spacer"
        },
        {
          "id": "clock",
          "format": "ddd dd HH:mm",
          "firstDay": "monday",
          "pill": true,
          "seconds": true
        },
        {
          "id": "spacer"
        },
        {
          "id": "monitors",
          "type": "command",
          "exec": "desktop-status-monitors",
          "interval": 10,
          "icon": "󰍹",
          "hideWhenEmpty": false,
          "colors": {
            "laptop": "muted",
            "unknown": "urgent"
          },
          "panel": "monitors",
          "onRightClick": "desktop-menu monitors"
        },
        {
          "id": "update"
        },
        {
          "id": "notifications"
        }
      ],
      "right": [
        {
          "id": "tray",
          "glyphs": {
            "KeePassXC": "",
            "remmina-icon": "",
            "Fcitx": "",
            "nm-applet": ""
          },
          "commands": {
            "remmina-icon": "remmina"
          }
        },
        {
          "id": "spacer",
          "width": 6
        },
        {
          "id": "connection",
          "type": "group",
          "show": [
            "network"
          ],
          "widgets": [
            {
              "id": "bluetooth"
            },
            {
              "id": "vpn"
            },
            {
              "id": "network"
            }
          ]
        },
        {
          "id": "spacer",
          "width": 6
        },
        {
          "id": "sound",
          "type": "group",
          "widgets": [
            {
              "id": "audio"
            },
            {
              "id": "microphone"
            }
          ]
        },
        {
          "id": "spacer",
          "width": 6
        },
        {
          "id": "agents",
          "type": "group",
          "widgets": [
            {
              "id": "ai",
              "type": "command",
              "exec": "desktop-status-ai",
              "interval": 15,
              "icon": "󱁉",
              "colors": {
                "critical": "urgent",
                "warning": "attention",
                "busy": "accent",
                "waiting": "urgent",
                "done": "good",
                "active": "muted"
              },
              "pulse": [
                "waiting",
                "done"
              ],
              "panel": "ai",
              "onRightClick": "desktop-menu agents",
              "orb": true
            },
            {
              "id": "camera",
              "type": "command",
              "exec": "desktop-status-camera",
              "interval": 3,
              "icon": "",
              "colors": {
                "on": "urgent"
              },
              "onClick": "desktop-menu camera"
            }
          ]
        },
        {
          "id": "spacer",
          "width": 6
        },
        {
          "id": "alerts",
          "type": "group",
          "widgets": [
            {
              "id": "security"
            },
            {
              "id": "backup",
              "type": "command",
              "exec": "desktop-backup status --bar",
              "interval": 300,
              "icon": "󰅧",
              "hideWhenEmpty": false,
              "colors": {
                "stale": "urgent",
                "never": "urgent",
                "running": "accent",
                "unconfigured": "attention",
                "unreachable": "muted"
              },
              "panel": "backup"
            }
          ]
        },
        {
          "id": "spacer",
          "width": 6
        },
        {
          "id": "system",
          "type": "group",
          "show": [
            "cpu",
            "battery"
          ],
          "widgets": [
            {
              "id": "disk",
              "path": "/"
            },
            {
              "id": "memory"
            },
            {
              "id": "cpu"
            },
            {
              "id": "battery"
            }
          ]
        }
      ]
    }
  }
}
