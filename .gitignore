# Unpacked by install/packaging/openshiftlocal.sh, which extracts into the working
# directory rather than a temp one. 100MB+ of binary, not source.
install/packaging/crc-linux-*/

# Ansible's local cache, created when a playbook is run from this directory.
.ansible/

# Compiled Python, written beside a script whenever a test imports it. It carries the
# absolute path of the machine it was compiled on.
__pycache__/
