#!/usr/bin/env bash

# desktop-theme-set: Set a theme, specified by its name.
# Usage: desktop-theme-set <theme-name>

if [[ -z "$1" && "$1" != "CNCLD" ]]; then
  echo "Usage: desktop-theme-set <theme-name>" >&2
  exit 1
fi

THEMES_DIR="$HOME/.config/desktop/themes/"
CURRENT_THEME_DIR="$HOME/.config/desktop/current/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR" >&2
  exit 2
fi

# Update theme symlinks
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"

# Change gnome modes
if [[ -f ~/.config/desktop/current/theme/light.mode ]]; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
else
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
fi

# Change gnome icon theme color
if [[ -f ~/.config/desktop/current/theme/icons.theme ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$(<~/.config/desktop/current/theme/icons.theme)"
else
  gsettings set org.gnome.desktop.interface icon-theme "Yaru-blue"
fi

# Restart components to apply new theme
pkill -SIGUSR2 btop
# Every running server re-reads the config, which re-sources the theme's tmux.conf.
tmux list-sessions &>/dev/null && tmux source-file ~/.config/tmux/tmux.conf
# The shell re-reads the theme in place; restarting it is only the fallback for a
# shell that is not running, or one too old to answer the call.
desktop-shell shell reloadTheme >/dev/null 2>&1 || desktop-restart-shell
#desktop-restart-swayosd
pgrep -x mako >/dev/null && makoctl reload
hyprctl reload

# Set new background
desktop-theme-bg-next
