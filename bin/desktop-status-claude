#!/usr/bin/env python3

"""Claude Code usage over the last five hours, as bar-friendly JSON.

Read from the transcripts in ~/.claude/projects and nothing else: no credentials, no
network. That makes this an honest local estimate rather than the authoritative rate
limit -- Anthropic's own numbers live behind the OAuth usage endpoint, which needs the
token in ~/.claude/.credentials.json. The window is five hours because that is the one
Claude Code's limits are measured over, so the shape of the number is comparable even
when the value is not.
"""

import json
import os
import sys
import time
from pathlib import Path

WINDOW_SECONDS = 5 * 60 * 60


def compact(value):
    for limit, suffix in ((1_000_000_000, "G"), (1_000_000, "M"), (1_000, "k")):
        if value >= limit:
            return f"{value / limit:.1f}{suffix}"
    return str(value)


def main():
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")).expanduser() / "projects"
    cutoff = time.time() - WINDOW_SECONDS

    tokens_in = tokens_out = cached = 0
    sessions = set()

    if root.is_dir():
        for path in root.glob("*/*.jsonl"):
            # A transcript untouched inside the window cannot hold a message inside it.
            try:
                if path.stat().st_mtime < cutoff:
                    continue
            except OSError:
                continue

            try:
                with path.open(errors="replace") as handle:
                    for line in handle:
                        try:
                            record = json.loads(line)
                        except ValueError:
                            continue

                        stamp = record.get("timestamp")
                        if isinstance(stamp, str):
                            try:
                                seconds = time.mktime(time.strptime(stamp[:19], "%Y-%m-%dT%H:%M:%S"))
                            except ValueError:
                                continue
                            # Transcript timestamps are UTC; compare in the same frame.
                            if seconds - time.timezone < cutoff:
                                continue

                        message = record.get("message")
                        usage = message.get("usage") if isinstance(message, dict) else None
                        if not isinstance(usage, dict):
                            continue

                        tokens_in += usage.get("input_tokens", 0) + usage.get("cache_creation_input_tokens", 0)
                        cached += usage.get("cache_read_input_tokens", 0)
                        tokens_out += usage.get("output_tokens", 0)
                        sessions.add(path.stem)
            except OSError:
                continue

    total = tokens_in + tokens_out
    if total == 0:
        print(json.dumps({"text": "", "class": "idle", "tooltip": "No Claude usage in the last 5h"}))
        return 0

    # Cache reads are counted separately: they dominate the raw total and are billed
    # and rate-limited at a fraction of fresh input, so folding them into the headline
    # would make the number look alarming and mean nothing.
    tooltip = (
        f"Claude Code, last 5h\n"
        f"{compact(tokens_in)} in / {compact(tokens_out)} out across {len(sessions)} session(s)\n"
        f"{compact(cached)} read from cache\n"
        f"Local transcript totals, not the authoritative limit"
    )
    print(json.dumps({"text": compact(total), "class": "active", "tooltip": tooltip}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
