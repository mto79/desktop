#!/usr/bin/env bash

# desktop-launch-shell: Start the Quickshell desktop shell under supervision.
#
# Quickshell links against Qt6 *private* API, so the binary is only valid for the exact
# Qt minor it was built against. On Fedora a Qt point release regularly lands before the
# COPR rebuilds, and quickshell then refuses to start. Losing the bar entirely for that
# window is worse than running the old one, so a shell that will not stay up falls back
# to waybar rather than leaving the session bare.

DESKTOP_PATH="${DESKTOP_PATH:-$HOME/.local/share/desktop}"
SHELL_PATH="$DESKTOP_PATH/shell"

MAX_RESTARTS=5
RESTART_WINDOW=60

if [[ ! -d "$SHELL_PATH" ]]; then
  echo "desktop-launch-shell: no shell at $SHELL_PATH" >&2
  exit 1
fi

fall_back_to_waybar() {
  echo "desktop-launch-shell: giving up, falling back to waybar" >&2
  setsid uwsm app -- waybar >/dev/null 2>&1 &
  # The shell owns notifications too, so the fallback has to bring mako back with it --
  # and before the notification below, which is the thing that would otherwise have no
  # daemon to draw it.
  pgrep -x mako >/dev/null || setsid uwsm app -- mako >/dev/null 2>&1 &
  sleep 1
  notify-send -u critical "Desktop shell failed" \
    "$(printf 'Quickshell would not stay running. Falling back to waybar.\nSee: journalctl --user -t desktop-shell')"
}

# Quickshell's own file watcher is off by default: desktop-update-git rewrites
# $DESKTOP_PATH in place, and a live watcher would reload against a half-written tree
# mid-pull. Set DESKTOP_SHELL_WATCH=1 to get hot reload while working on the QML.
if [[ -n "${DESKTOP_SHELL_WATCH:-}" ]]; then
  export QS_DISABLE_FILE_WATCHER=0
else
  export QS_DISABLE_FILE_WATCHER=1
  export QS_NO_RELOAD_POPUP=1
fi

# Without a platform theme Qt looks up icons in hicolor and nowhere else, so any tray
# icon that lives only in the session's actual theme renders as Qt's magenta and black
# checkerboard -- fcitx5's input-keyboard-symbolic is in Adwaita and Yaru, not hicolor,
# and looked like a broken bar. gtk3 makes Qt read the icon theme GTK is configured with
# (Yaru-magenta, which inherits Yaru).
#
# Exported here rather than in the session environment on purpose: it would otherwise
# apply to every Qt application, and this session sets QT_STYLE_OVERRIDE=kvantum, whose
# styling the gtk3 platform theme would start arguing with. The shell is the only thing
# that needs it.
export QT_QPA_PLATFORMTHEME=gtk3

# mako claims org.freedesktop.Notifications through D-Bus activation, not through a
# unit anyone enabled: its service file names the bus directly, so the first
# notification that arrives before the shell has registered starts it, and it then holds
# the bus for the rest of the session. The shell comes up otherwise healthy, logs one
# line about the name already being taken, and quietly draws none of the notifications.
#
# desktop-restart-shell already retires the fallback once the shell answers IPC. The
# login path needs the same and did not have it, which is the difference between a
# restarted session and a fresh one. Quickshell re-registers by itself the moment the
# name is released, so killing the squatter is the whole fix.
#
# Masking mako.service would look like the tidier answer and is not: uwsm app -- mako
# cannot start a masked unit, so it would disarm the fallback below at the same time.
#
# Bounded, and started once rather than per restart: the fallback deliberately runs mako
# when the shell will not stay up, and a waiter still polling then would kill the very
# thing that was just started to cover for it.
retire_fallback() {
  for _ in $(seq 40); do
    if timeout 1 quickshell ipc -p "$SHELL_PATH" call -- shell ping >/dev/null 2>&1; then
      pkill -x waybar
      pkill -x mako
      return
    fi
    sleep 0.25
  done
}
retire_fallback &

restarts=0
window_started=$SECONDS

while true; do
  # systemd-cat so QML warnings reach the journal. Without it Quickshell logs only to a
  # tmpfs runtime dir, which makes a failed start look like silence.
  systemd-cat -t desktop-shell -- quickshell -p "$SHELL_PATH"
  status=$?

  [[ $status -eq 0 ]] && exit 0

  # A session that is tearing down takes the shell with it. Exiting quietly here keeps
  # a normal logout from burning the restart budget and firing the waybar fallback.
  if ! hyprctl -j monitors >/dev/null 2>&1; then
    exit 0
  fi

  if (($SECONDS - window_started > RESTART_WINDOW)); then
    restarts=0
    window_started=$SECONDS
  fi

  restarts=$((restarts + 1))
  if ((restarts >= MAX_RESTARTS)); then
    fall_back_to_waybar
    exit 1
  fi

  echo "desktop-launch-shell: exited $status, restart $restarts/$MAX_RESTARTS" >&2
  sleep 1
done
