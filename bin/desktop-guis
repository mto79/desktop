#!/usr/bin/env bash

# desktop-guis: the web GUIs of what you are working on, ready on workspace 1.
#
#   desktop-guis open <group>     a browser window with the group's links as tabs
#   desktop-guis close <group>    that window closed
#   desktop-guis list             the groups, and which are open
#   desktop-guis arrange          the windows on workspace 1 as one Hyprland group, home first
#   desktop-guis import <url>     the clusters' links from a Homer dashboard
#
# The groups are in ~/.config/desktop/guis.conf: [home], which opens at login, and one
# section per cluster, which `ocl` opens when you sign in to the cluster and closes when
# you sign out. A line a link, the URL and then whatever name you like:
#
#   [home]
#   https://git.example/                         GitLab
#
#   [ocp203]
#   https://console-openshift-console.apps.ocp203.example/   OpenShift
#
# Never in the repository: it names hosts, and the repository is public.
#
# The windows come from a browser profile of their own, started with a class of its own,
# desktop-guis, which a window rule sends to workspace 1 without following it
# (default/hypr/apps/guis.lua). That is what makes it ready there rather than gone to:
# Hyprland's own groups cannot be put together without focusing each window in turn, and
# a window placed by its title is placed too late -- a browser names a window only once its
# page has loaded. A profile of its own keeps these sign-ins apart from your browsing too.
#
# On workspace 1 they are one Hyprland group, a tab each, named after its group -- home,
# ocp202, ocp203 -- in the theme's colours. Put together when you arrive there: Hyprland
# moves a window into a group only by focusing it, which is fine once you are looking, and
# never pulls you there to do it. guis.lua runs `arrange` on going to workspace 1, and open
# runs it when workspace 1 is the one on screen.
#
# The profile is dressed as the desktop: a theme generated from the current theme's
# shell.json -- the tab strip the bar's colour, the toolbar the theme's background -- and
# the desktop's font for the tabs and the address bar, through a GSettings file of its own.

set -uo pipefail

CONF="${DESKTOP_GUIS:-${XDG_CONFIG_HOME:-$HOME/.config}/desktop/guis.conf}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/guis"
# Not under ~/.local/share/desktop: that is the repository, and this holds sign-ins.
PROFILE="$STATE/browser"
RUN="${XDG_RUNTIME_DIR:-/tmp}/desktop/guis"
THEME_DIR="${DESKTOP_THEME_DIR:-$HOME/.config/desktop/current/theme}"
CLASS=desktop-guis

die() {
  echo "desktop-guis: $*" >&2
  exit 1
}

# The links of a group, one URL a line; nothing when there is no such group.
links() {
  [[ -r $CONF ]] || return 0
  awk -v want="[$1]" '
    /^[[:space:]]*\[/ { gsub(/[[:space:]]/, ""); on = ($0 == want); next }
    on { sub(/(^|[[:space:]])#.*/, ""); if (NF) print $1 }' "$CONF"
}

groups() {
  [[ -r $CONF ]] || return 0
  sed -nE 's/^[[:space:]]*\[([^]]+)\].*/\1/p' "$CONF"
}

# The browser: the default one when it is Chromium-based, since a theme and a class of its
# own are Chromium's; chromium otherwise.
browser() {
  local desktop exec
  desktop=$(xdg-settings get default-web-browser 2>/dev/null)
  case $desktop in
  google-chrome* | brave-browser* | microsoft-edge* | vivaldi* | chromium*) ;;
  *) desktop=chromium-browser.desktop ;;
  esac
  exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/"$desktop" 2>/dev/null | head -1)
  echo "${exec:-chromium-browser}"
}

addresses() {
  hyprctl -j clients 2>/dev/null | jq -r --arg c "$CLASS" '.[] | select(.class == $c) | .address'
}

# Is the window a group opened still there? Home's is your own browser's, of any class.
is_open() {
  [[ -s $RUN/$1 ]] || return 1
  hyprctl -j clients 2>/dev/null | jq -e --arg a "$(cat "$RUN/$1")" 'any(.[]; .address == $a)' >/dev/null
}

running() { pgrep -f -- "--user-data-dir=$PROFILE( |$)" >/dev/null 2>&1; }

# Your own browser running already: a main process -- no --type=, which its helpers have --
# with no profile of its own, which the GUIs' has.
own_running() {
  pgrep -a -x 'brave|chrome|chromium|chromium-browser|msedge|vivaldi-bin' 2>/dev/null |
    grep -v -e '--type=' -e '--user-data-dir=' | grep -q .
}

# What the profile is dressed in, written before it starts: Chromium reads both only then.
dress() {
  local font
  mkdir -p "$PROFILE/Default" "$STATE/theme" "$STATE/env/glib-2.0/settings"
  # The theme is the one every Chromium browser here wears (desktop-browser-theme).
  DESKTOP_THEME_DIR="$THEME_DIR" desktop-browser-theme chromium "$STATE/theme"
  python3 - "$PROFILE/Default/Preferences" <<'EOF'
import json, os, sys
prefs = sys.argv[1]
try:
    p = json.load(open(prefs))
except (OSError, ValueError):
    p = {}
# Dark, and the windows of last time not brought back: a group is opened when it is wanted.
p.setdefault("browser", {}).setdefault("theme", {})["color_scheme2"] = 2
p["browser"]["has_seen_welcome_page"] = True
p.setdefault("session", {})["restore_on_startup"] = 5
# Brave's own first-run notice about its usage statistics, answered: off, and not asked.
p.setdefault("brave", {})["p3a"] = {"enabled": False, "notice_acknowledged": True}
# A group's window is closed for you on sign-out; Brave would otherwise stop and ask
# whether all its tabs are to go, and the window stayed.
p["brave"]["enable_window_closing_confirm"] = False
json.dump(p, open(prefs, "w"))
# Gone with its last window, rather than kept running in the background: the next group
# then starts it afresh, in the theme and the font of the moment. A setting of the whole
# profile directory, so in Local State rather than the profile's Preferences.
local = os.path.join(os.path.dirname(os.path.dirname(prefs)), "Local State")
try:
    state = json.load(open(local))
except (OSError, ValueError):
    state = {}
state.setdefault("background_mode", {})["enabled"] = False
json.dump(state, open(local, "w"))
EOF
  font=$(desktop-font-current 2>/dev/null)
  printf "[org/gnome/desktop/interface]\nfont-name='%s 11'\ncolor-scheme='prefer-dark'\n" "${font:-monospace}" \
    >"$STATE/env/glib-2.0/settings/keyfile"
}

# KeePassXC-Browser, as your own browser has it installed, the newest version: copied into
# the GUIs' state and the copy loaded beside the theme -- the cluster GUIs are where the
# passwords are wanted. A copy, never your browser's own folder: a browser loading a folder
# as an extension deletes its _metadata, the Web Store's signed checksums, and your own
# browser then took the extension for corrupted and turned it off. The manifest keeps the
# Store's key, so the copy has the Store's ID, the one KeePassXC's native-messaging host
# lets in. The host's manifest is linked where the browser looks for it: not in the
# --user-data-dir, but in its default one, under XDG_CONFIG_HOME -- which for these
# windows is $STATE/env, the font's (dress), so the link goes there. Nothing when your
# browser has no KeePassXC-Browser. Connecting it to KeePassXC is asked once, the first time it is used
# in this profile.
KEEPASSXC_BROWSER=oboonakemofpalcgghocfoadofidjkkk
keepassxc_browser() {
  local name root dir copy host=org.keepassxc.keepassxc_browser.json
  for name in BraveSoftware/Brave-Browser google-chrome chromium microsoft-edge vivaldi; do
    root="${XDG_CONFIG_HOME:-$HOME/.config}/$name"
    dir=$(printf '%s\n' "$root"/*/Extensions/"$KEEPASSXC_BROWSER"/*/manifest.json 2>/dev/null |
      grep -v '\*' | sort -V | tail -1)
    [[ -n $dir ]] || continue
    dir=$(dirname "$dir")
    # A version's copy is made once; another version's replaces it.
    copy="$STATE/keepassxc-browser/$(basename "$dir")"
    if [[ ! -f $copy/manifest.json ]]; then
      rm -rf "$STATE/keepassxc-browser"
      mkdir -p "$STATE/keepassxc-browser"
      cp -r "$dir" "$copy.tmp" && rm -rf "$copy.tmp/_metadata" && mv "$copy.tmp" "$copy" || return 1
    fi
    if [[ -f $root/NativeMessagingHosts/$host ]]; then
      mkdir -p "$STATE/env/$name/NativeMessagingHosts"
      ln -sfn "$root/NativeMessagingHosts/$host" "$STATE/env/$name/NativeMessagingHosts/$host"
    fi
    echo "$copy"
    return 0
  done
  return 1
}

# Is this window the user's own browser's, which is what home is? At login a terminal maps in
# the same burst and head -1 once took that. Home's window is of the browser's own app-id --
# the GUIs' profile is class desktop-guis (left out of the diff), a terminal's its own -- so
# the new window that is a browser is home's. The family browser() can hand back.
#
# And by its title, home: a browser started at login opens a window of its own as well -- an
# empty New Tab, or the last session's -- and taking that one left two on workspace 1.
is_home_window() {
  local class title
  IFS=$'\t' read -r class title < <(hyprctl -j clients 2>/dev/null |
    jq -r --arg a "$1" '.[] | select(.address == $a) | [.class, .title] | @tsv')
  [[ $title == home ]] || return 1
  case $class in
  google-chrome* | brave-browser* | microsoft-edge* | vivaldi* | chromium*) return 0 ;;
  *) return 1 ;;
  esac
}

# Home on workspace 1, wherever it opened. A window of your own browser has no class to be
# placed by, so it opens on the workspace on screen when it appears -- and at login the
# browser takes seconds to start, by when you may be elsewhere: home, and the session it
# restored, came up on workspace 2. Moved without following, so you stay where you are.
home_to_one() {
  local address workspace
  [[ -s $RUN/home ]] || return 0
  address=$(cat "$RUN/home")
  workspace=$(hyprctl -j clients 2>/dev/null | jq -r --arg a "$address" '.[] | select(.address == $a) | .workspace.id')
  [[ -n $workspace && $workspace != 1 ]] || return 0
  # In a group there with windows of its own -- Teams, restored beside it -- it would take
  # them along: a group moves whole. Theirs are let go first, by address, no focus needed.
  local member
  while read -r member; do
    [[ -n $member && $member != "$address" ]] || continue
    grep -qxF "$member" "$RUN"/* 2>/dev/null && continue
    hyprctl dispatch "hl.dsp.window.move({ out_of_group = true, window = \"address:$member\" })" >/dev/null
  done < <(group_of "$address")
  hyprctl dispatch "hl.dsp.window.move({ workspace = 1, window = \"address:$address\", follow = false })" >/dev/null
}

# A window named home there already -- the browser's session restore brings back the last
# one, name and all -- is taken as home rather than a second opened beside it.
adopt_home() {
  local address
  while read -r address; do
    is_home_window "$address" && { echo "$address" >"$RUN/home"; home_to_one; return 0; }
  done < <(hyprctl -j clients 2>/dev/null | jq -r --arg c "$CLASS" '.[] | select(.class != $c) | .address')
  return 1
}

# What else the browser opened as it started, on workspace 1 beside home: an empty New Tab
# window is closed, so the workspace has the one browser. A window with pages in it -- the
# session restored -- is yours and is left.
close_extra() { # addresses that appeared with home
  local address title workspace
  while read -r address; do
    [[ -n $address && $address != "$(cat "$RUN/home")" ]] || continue
    IFS=$'\t' read -r title workspace < <(hyprctl -j clients 2>/dev/null |
      jq -r --arg a "$address" '.[] | select(.address == $a) | [.title, .workspace.id] | @tsv')
    [[ $workspace == 1 && $title == "New Tab"* ]] || continue
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null
  done
}

# Home is your own browser -- your profile, your bookmarks -- not the GUIs' profile: a window
# of it named home, the first tab on workspace 1, with [home]'s links if it has any. A
# window of your own browser has no class to be sent to workspace 1 by, so it is opened only
# while workspace 1 is on screen, where it then opens: at login, and on arriving there.
open_home() {
  local urls before after new i theme
  [[ $(active_workspace) == 1 ]] || return 0
  is_open home && return 0
  # One at a time, and asked again once it is this one's turn: at login the start of the
  # session and the arrival on workspace 1 both open home, and each made one.
  mkdir -p "$RUN"
  exec 9>"$RUN/.lock"
  flock 9
  is_open home && return 0
  adopt_home && { flock -u 9; return 0; }
  mapfile -t urls < <(links home)
  # In the theme your browser's launcher gives it (desktop-browser-theme), should this be
  # what starts it.
  theme="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/browser-theme/chromium"
  [[ -f $theme/manifest.json ]] || DESKTOP_THEME_DIR="$THEME_DIR" desktop-browser-theme chromium "$theme"
  mkdir -p "$RUN"
  before=$(hyprctl -j clients 2>/dev/null | jq -r '.[].address' | sort)
  # The theme only for a browser this starts: handed to one already running, those switches
  # make it pass over --window-name too, and home would be named after its page.
  local flags=(--disable-features=DisableLoadExtensionCommandLineSwitch --load-extension="$theme")
  local starting=true
  own_running && { flags=(); starting=false; }
  setsid uwsm app -- "$(browser)" "${flags[@]}" --new-window --window-name=home "${urls[@]}" \
    >/dev/null 2>&1 8>&- 9>&- &
  # Other windows map in the same burst, at login above all: take the one the browser
  # named home, not merely the first new one, which once was a terminal.
  for ((i = 0; i < 60; i++)); do
    sleep 0.25
    after=$(hyprctl -j clients 2>/dev/null | jq -r --arg c "$CLASS" '.[] | select(.class != $c) | .address' | sort)
    while read -r new; do
      [[ -n $new ]] || continue
      if is_home_window "$new"; then
        echo "$new" >"$RUN/home"
        home_to_one
        # Started by this, the browser opens a window of its own too, a moment apart.
        if $starting; then
          sleep "${DESKTOP_GUIS_SETTLE:-3}"
          after=$(hyprctl -j clients 2>/dev/null | jq -r --arg c "$CLASS" '.[] | select(.class != $c) | .address' | sort)
          close_extra < <(comm -13 <(echo "$before") <(echo "$after"))
        fi
        flock -u 9
        return 0
      fi
    done < <(comm -13 <(echo "$before") <(echo "$after"))
  done
  echo "desktop-guis: home's window did not appear" >&2
  return 1
}

cmd_open() {
  local name=$1 urls before after new i
  if [[ $name == home ]]; then
    open_home || return 1
    [[ -z ${ARRANGING:-} ]] && cmd_arrange
    return 0
  fi
  mapfile -t urls < <(links "$name")
  ((${#urls[@]})) || return 0
  mkdir -p "$RUN"
  exec 9>"$RUN/.lock"
  flock 9
  # Open already: left as it is.
  if [[ -s $RUN/$name ]] && addresses | grep -qxF "$(cat "$RUN/$name")"; then
    return 0
  fi
  before=$(addresses)
  running || dress
  local extensions=$STATE/theme keepassxc
  keepassxc=$(keepassxc_browser) && extensions+=",$keepassxc"
  # Without the lock's descriptor: a browser that kept it would hold the lock for as long
  # as it runs, and the next group would wait for it for ever.
  XDG_CONFIG_HOME="$STATE/env" GSETTINGS_BACKEND=keyfile setsid uwsm app -- "$(browser)" \
    --user-data-dir="$PROFILE" --class="$CLASS" --no-first-run --no-default-browser-check \
    --disable-features=DisableLoadExtensionCommandLineSwitch --load-extension="$extensions" \
    --new-window --window-name="$name" "${urls[@]}" >/dev/null 2>&1 9>&- &
  # The new window, to be closed by when the group is.
  for ((i = 0; i < 60; i++)); do
    sleep 0.25
    after=$(addresses)
    new=$(comm -13 <(sort <<<"$before") <(sort <<<"$after") | head -1)
    if [[ -n $new ]]; then
      echo "$new" >"$RUN/$name"
      flock -u 9
      # Unless this is home being opened by an arrange, which goes on to take it in.
      [[ -z ${ARRANGING:-} && $(active_workspace) == 1 ]] && cmd_arrange
      return 0
    fi
  done
  echo "desktop-guis: $name's window did not appear" >&2
  return 1
}

active_workspace() { hyprctl -j activeworkspace 2>/dev/null | jq -r '.id // empty'; }

# A window's group, as the addresses in it; empty when it is in none.
group_of() { hyprctl -j clients 2>/dev/null | jq -r --arg a "$1" '.[] | select(.address == $a) | .grouped[]'; }

# The window that has the focus; empty when none has.
active_window() { hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty'; }

# The window focused, as a step of arranging -- only while you are still on workspace 1,
# and only if it took. Arranging is done by focus, and a focus sent after you had moved on
# took you back there: passing through workspace 1 as a cluster's window waited to join
# flickered back and forth. And a focus that did not take -- the window gone meanwhile --
# left the next into_group to move whatever else had the focus, wherever it was.
step_to() {
  [[ $(active_workspace) == 1 ]] || return 1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null
  [[ $(active_window) == "$1" ]]
}

# Still where arranging left it: the window focused, on workspace 1, before each move of it.
still_at() { [[ $(active_workspace) == 1 && $(active_window) == "$1" ]]; }

# The GUI windows on workspace 1 as one group: the first in guis.conf's order -- home --
# heads it and the rest join in that order. Only while workspace 1 is on screen: leave it
# and arranging stops where it is, to be taken up the next time you are there. The focus
# is given back to the window that had it.
cmd_arrange() {
  local order=() name address head focus joined d
  [[ $(active_workspace) == 1 ]] || return 0
  mkdir -p "$RUN"
  exec 8>"$RUN/.arrange"
  flock -n 8 || return 0
  ARRANGING=1
  # Workspace 1 starts with home, whatever was closed meanwhile -- opened beside this rather
  # than waited for: a browser takes seconds to start, and a group put together after you had
  # gone pulled you back. Its own open arranges again once it is there.
  is_open home || setsid "$0" open home </dev/null >/dev/null 2>&1 8>&- &
  # Open but somewhere else -- opened while you were elsewhere -- it is brought here.
  is_open home && home_to_one
  while read -r name; do
    [[ -s $RUN/$name ]] || continue
    address=$(cat "$RUN/$name")
    hyprctl -j clients | jq -e --arg a "$address" '.[] | select(.address == $a and .workspace.id == 1)' >/dev/null 2>&1 &&
      order+=("$address")
  done < <(echo home; groups | grep -vx home)
  ((${#order[@]})) || return 0
  focus=$(active_window)
  # The head: one already in a group, else the first.
  head=""
  for address in "${order[@]}"; do
    [[ -n $(group_of "$address") ]] && { head=$address; break; }
  done
  if [[ -z $head ]]; then
    head=${order[0]}
    step_to "$head" && still_at "$head" || return 0
    hyprctl dispatch "hl.dsp.group.toggle()" >/dev/null
  fi
  for address in "${order[@]}"; do
    group_of "$head" | grep -qxF "$address" && continue
    step_to "$address" || return 0
    joined=false
    for d in left right up down; do
      still_at "$address" || return 0
      hyprctl dispatch "hl.dsp.window.move({ into_group = \"$d\" })" >/dev/null
      if group_of "$head" | grep -qxF "$address"; then joined=true; break; fi
      # Into some other group that was in the way: out again, and on to the next way.
      [[ -n $(group_of "$address") ]] && still_at "$address" &&
        hyprctl dispatch 'hl.dsp.window.move({ out_of_group = true })' >/dev/null
    done
    $joined || echo "desktop-guis: could not put $address into the group" >&2
  done
  # Home the first tab, however late it joined: a place back at a time until it is.
  if is_open home; then
    address=$(cat "$RUN/home")
    if [[ $(group_of "$address" | head -1) != "$address" ]]; then
      step_to "$address" || return 0
      for _ in $(seq "$(group_of "$address" | wc -l)"); do
        [[ $(group_of "$address" | head -1) == "$address" ]] && break
        still_at "$address" || return 0
        hyprctl dispatch 'hl.dsp.group.move_window({ forward = false })' >/dev/null
      done
    fi
  fi
  # Given back only while you are still here: from anywhere else it would take you back.
  [[ -n $focus && $(active_workspace) == 1 ]] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$focus\" })" >/dev/null
  return 0
}


cmd_close() {
  local name=$1 address
  [[ -s $RUN/$name ]] || return 0
  address=$(cat "$RUN/$name")
  if is_open "$name"; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null
  fi
  rm -f "$RUN/$name"
  # The last window gone, the browser goes too. Brave keeps itself running in the
  # background whatever the profile says; ended, the next group starts it afresh, in the
  # theme and the font of the moment.
  for _ in $(seq 20); do
    [[ -z $(addresses) ]] && break
    sleep 0.2
  done
  [[ -z $(addresses) ]] && pkill -TERM -f -- "--user-data-dir=$PROFILE( |$)" 2>/dev/null
  return 0
}

cmd_list() {
  local name state
  while read -r name; do
    state=closed
    is_open "$name" && state=open
    printf '%-12s %-7s %s links\n' "$name" "$state" "$(links "$name" | wc -l)"
  done < <(echo home; groups | grep -vx home)
}

# A Homer dashboard's sections named after a cluster -- "OCP203 | Production" -- become that
# cluster's group, every link in it. The other groups in the file, [home] first, are kept
# as they are; a cluster's group that was there is replaced.
cmd_import() {
  local url=$1 yaml
  [[ $url == */config.yml ]] || url="${url%/}/assets/config.yml"
  yaml=$(mktemp)
  # Expanded now: the trap runs after this function, when its locals are gone.
  # shellcheck disable=SC2064
  trap "rm -f '$yaml'" EXIT
  curl -fsSL --max-time 20 -o "$yaml" "$url" || die "could not fetch $url"
  mkdir -p "$(dirname "$CONF")"
  [[ -f $CONF ]] || printf '# desktop-guis: [group], then a link a line -- the URL and a name.\n\n[home]\n' >"$CONF"
  python3 - "$CONF" "$yaml" <<'EOF' || die "could not read $url as a Homer config"
import re, sys, yaml
conf, source = sys.argv[1:]
homer = yaml.safe_load(open(source)) or {}
found = {}
for section in homer.get("services") or []:
    m = re.match(r"\s*([A-Za-z]+\d+)\b", section.get("name") or "")
    if not m:
        continue
    lines = []
    for item in section.get("items") or []:
        if item.get("url"):
            lines.append(f"{item['url']}  {item.get('name', '')}".rstrip())
    found[m.group(1).lower()] = lines
# The file as it is, with the clusters' groups taken out where Homer has them.
kept, skip = [], False
for line in open(conf).read().splitlines():
    head = re.match(r"\s*\[([^]]+)\]", line)
    if head:
        skip = head.group(1) in found
    if not skip:
        kept.append(line)
while kept and not kept[-1].strip():
    kept.pop()
out = kept
for name in sorted(found):
    out += ["", f"[{name}]"] + found[name]
open(conf, "w").write("\n".join(out) + "\n")
print(f"{len(found)} groups from Homer: {', '.join(sorted(found))}")
EOF
}

case "${1:-}" in
open) cmd_open "${2:?usage: desktop-guis open <group>}" ;;
close) cmd_close "${2:?usage: desktop-guis close <group>}" ;;
list) cmd_list ;;
arrange) cmd_arrange ;;
import) cmd_import "${2:?usage: desktop-guis import <homer url>}" ;;
-h | --help | "") sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command '$1' (see desktop-guis --help)" ;;
esac
