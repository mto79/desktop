#!/usr/bin/env bash

# desktop-status-ai: running agents and token usage, as one bar module.
#
#   {"text":"5","gauges":[{"text":"60%","level":0.6},{"text":"3%","level":0.03}],"class":"busy",...}
#
# Two widgets sat side by side saying related things about the same subject, and each
# one paid the bar's full padding for the privilege. Merging them costs a separator and
# saves a widget's worth of horizontal space.
#
# Composed from the two existing scripts rather than reimplementing either: the limit
# accounting in desktop-status-claude is the fiddly part, and there is no reason for two
# copies of it. `class` follows the agents -- a running agent is the thing worth
# colouring the bar for -- except when the usage figure has turned into an alert of its
# own. A week that is 95% spent outranks the news that something is running.

set -uo pipefail

agents=$(desktop-status-agents 2>/dev/null) || agents=''
claude=$(desktop-status-claude 2>/dev/null) || claude=''

# A missing or unparseable half degrades to the other rather than blanking the module.
echo "$agents" | jq -e . >/dev/null 2>&1 || agents='{"text":"","class":"idle","tooltip":""}'
echo "$claude" | jq -e . >/dev/null 2>&1 || claude='{"text":"","class":"idle","tooltip":""}'

jq -c -n --argjson a "$agents" --argjson c "$claude" '
  ($a.text // "") as $agentText
  | ($c.gauges // []) as $gauges
  # With gauges the limits are drawn from those, each in its own colour, and the headline
  # percentage would only say one of them twice.
  | (if ($gauges | length) > 0 then "" else ($c.text // "") end) as $tokenText
  | {
      text: (
        if $agentText != "" and $tokenText != "" then $agentText + " · " + $tokenText
        elif $agentText != "" then $agentText
        else $tokenText
        end
      ),
      class: (
        if (($c.class // "") | IN("warning", "critical")) then $c.class
        elif $agentText != "" then ($a.class // "busy")
        else ($c.class // "idle")
        end
      ),
      # The waiting count stays visible whichever half wins the colour; see CommandWidget.
      badge: ($a.badge // ""),
      gauges: $gauges,
      tooltip: (
        [($a.tooltip // ""), ($c.tooltip // "")]
        | map(select(. != ""))
        | join("\n\n")
      )
    }'
