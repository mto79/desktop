#!/usr/bin/env bash

# desktop-agent: run a coding agent and say so when it stops unexpectedly.
#
#   desktop-agent claude
#   desktop-agent opencode --flag
#
# Agents run in tmux windows nobody is looking at, so one that dies takes a while to be
# noticed. A clean exit says nothing; a crash or a non-zero exit sends a notification
# naming the project it died in.

set -uo pipefail

# Hyprland's environment is fixed when the session starts, so a keybinding launched
# today still has the PATH the session was born with -- no ~/.local/bin, where claude
# lives, and no ~/.cargo/bin. config/uwsm/env fixes that for the next login; this makes
# the wrapper work now, and keeps it working when it is called from somewhere odd.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH" ;;
esac

AGENT="${1:?usage: desktop-agent <claude|opencode> [args...]}"
shift

# Another opencode with this directory as its own: then "the last session" here may be
# that one's.
others_here() {
  local pid
  for pid in $(pgrep -u "$UID" -x opencode); do
    ((pid != $$)) && [[ $(readlink "/proc/$pid/cwd" 2>/dev/null) == "$PWD" ]] && return 0
  done
  return 1
}

# A wrapper that is started by the desktop rather than by a shell cannot assume the
# shell's PATH. Saying which agent is missing beats bash's "command not found" arriving
# in a window that is about to close.
if ! command -v "$AGENT" >/dev/null 2>&1; then
  message="$AGENT is not on PATH ($PATH)"
  echo "desktop-agent: $message" >&2
  notify-send -u critical "Cannot start $AGENT" "$message"
  exit 127
fi

# OpenCode's renderer (OpenTUI) can read past the end of its screen buffer when the
# display scale under it changes -- a window moving between the laptop screen and a
# monitor at another scale, which is what logging in docked does to every agent pane at
# once. Bun ends the process with a trap, so it dies of SIGILL (anomalyco/opencode#42094).
# The conversation is on disk, so the pane starts it again, and goes back into it when
# no other opencode works in this directory and could own the last session instead.
# Turning the JIT off was tried first and made no difference.
restarts=()
while :; do
  started=$SECONDS
  "$AGENT" "$@"
  code=$?
  [[ ${AGENT##*/} == opencode && $code -eq 132 ]] || break
  # A crash in the first seconds is not the one above, and three in ten minutes is a
  # loop; either is left to the notification below.
  now=$SECONDS
  restarts=($(for t in "${restarts[@]}"; do ((now - t < 600)) && echo "$t"; done) "$now")
  ((now - started >= ${DESKTOP_AGENT_MIN_UP:-5} && ${#restarts[@]} <= 3)) || break
  echo "desktop-agent: opencode crashed (SIGILL), starting it again" >&2
  if [[ " $* " != *" -c "* && " $* " != *" --continue "* && " $* " != *" -s "* && " $* " != *" --session"* ]] &&
    ! others_here; then
    set -- --continue "$@"
  fi
  sleep 1
done

if ((code == 0)); then
  exit 0
fi

if ((code > 128)); then
  reason="killed by signal $((code - 128))"
else
  reason="exited $code"
fi

notify-send -u critical "$AGENT stopped" "$reason in ${PWD/#$HOME/\~}"
exit "$code"
