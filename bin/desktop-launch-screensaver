#!/usr/bin/env bash

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensaver is already running. The title is on ghostty's command
# line, so pgrep still finds it the way it found the class before.
pgrep -f org.desktop.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/desktop/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch focusmonitor $m

  hyprctl dispatch exec -- \
    ghostty --title=org.desktop.screensaver \
    --background=000000 --cursor-color=000000 \
    --font-size=18 --background-opacity=1 \
    -e desktop-cmd-screensaver
done

hyprctl dispatch focusmonitor $focused
