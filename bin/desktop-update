#!/usr/bin/env bash

set -e

# Sudo keep-alive
if ! sudo -n true 2>/dev/null; then
  sudo -v
fi
while true; do
  sudo -n true
  sleep 60
  kill -0 "$$" || exit
done 2>/dev/null &

desktop-update-git
desktop-migrate
desktop-update-cargo
desktop-update-flatpak
desktop-update-system-pkgs
desktop-update-firmware
desktop-update-restart

# Clear the update indicator now rather than waiting for its next poll. This is the
# Quickshell equivalent of the SIGRTMIN+7 nudge waybar used: it re-runs one widget's
# check, not the whole shell. Failure is fine -- the shell may not be running, and the
# poll will catch up either way.
desktop-shell shell refreshUpdates >/dev/null 2>&1 || true
