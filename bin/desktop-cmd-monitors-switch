#!/usr/bin/env bash

# desktop-cmd-monitors-switch: apply a monitor layout.
#
#   desktop-cmd-monitors-switch           # the best layout for what is attached
#   desktop-cmd-monitors-switch <name>    # a named layout
#   desktop-cmd-monitors-switch --list    # layouts that could be applied right now
#   desktop-cmd-monitors-switch --current # the layout in force, if it was applied here
#
# With no argument it is also what desktop-monitors-watch runs on every plug and
# unplug, so it is written to be worth running when nothing has changed: it applies a
# layout only when the file it would write differs from the one in force.
#
# ~/.config/hypr/monitors.conf is generated from whichever layout is chosen, so it is
# not a file to edit -- the layouts below are. A layout whose monitor is not plugged in
# is never listed and never chosen, and connectors are resolved by model at apply time,
# since DP-8 today can be DP-10 tomorrow.

set -euo pipefail

CONF="$HOME/.config/hypr/monitors.conf"
LAPTOP="${DESKTOP_LAPTOP_MONITOR:-eDP-1}"

WORK_MODEL="HP P34hc G4"
HOME_MODEL="LS34A650U"
HOME_LEFT_MODEL="LG Ultra HD"

MONITORS_JSON="$(hyprctl monitors all -j)"

connector_for_model() {
  jq -r --arg model "$1" 'first(.[] | select(.model == $model) | .name) // ""' <<<"$MONITORS_JSON"
}

attached_connectors() {
  jq -r '.[].name' <<<"$MONITORS_JSON"
}

# Each layout prints its monitor lines, or fails when its screens are not here.
layout_work() {
  local dock
  dock="$(connector_for_model "$WORK_MODEL")"
  [[ -n "$dock" ]] || return 1

  echo "monitor=$LAPTOP, 3840x2400@60, 2160x1440, 2"
  echo "monitor=$dock, 3440x1440@60, 2160x0, 1"
}

layout_home() {
  local main left
  main="$(connector_for_model "$HOME_MODEL")"
  left="$(connector_for_model "$HOME_LEFT_MODEL")"
  # Either screen is enough to know which desk this is. Demanding the ultrawide meant a
  # home desk with only the portrait screen attached matched no layout at all, fell
  # through to laptop, and had that screen disabled for its trouble.
  [[ -n "$main" || -n "$left" ]] || return 1

  echo "monitor=$LAPTOP, 3840x2400@60, 2160x1440, 2"
  [[ -n "$main" ]] && echo "monitor=$main, 3440x1440@60, 2160x0, 1"
  [[ -n "$left" ]] && echo "monitor=$left, 3840x2160@60, 0x0, 1, transform, 1"
  # A layout reports itself unavailable by failing, so it must not end on a test: while
  # this one did, the ultrawide standing alone was quietly filtered out of the menu.
  return 0
}

layout_laptop() {
  echo "monitor=$LAPTOP, 3840x2400@60, 2160x1440, 2"
}

LAYOUTS=(work home laptop)

list_layouts() {
  local name
  for name in "${LAYOUTS[@]}"; do
    "layout_$name" >/dev/null 2>&1 && echo "$name"
  done
}

current_layout() {
  [[ -f "$CONF" ]] || return 0
  sed -n 's/^# layout: //p' "$CONF" | head -1
}

# The monitor lines a layout comes to, disables included. Separate from writing them so
# auto_layout can ask what a layout would do without doing it.
compose_layout() {
  local name="$1" lines used connector
  lines="$("layout_$name" 2>/dev/null)" || return 1

  echo "$lines"

  # Anything attached and unused is turned off explicitly. Without this a monitor
  # keeps whatever the previous layout gave it, and switching desks leaves a screen
  # sitting in a position that belongs to the other one.
  used=$(cut -d, -f1 <<<"$lines" | sed 's/^monitor=//')
  for connector in $(attached_connectors); do
    grep -qx "$connector" <<<"$used" || echo "monitor=$connector, disable"
  done
}

# What the generated file holds now, in the shape compose_layout prints it.
current_body() {
  [[ -f "$CONF" ]] || return 0
  grep '^monitor=' "$CONF" || true
}

apply_layout() {
  local name="$1" body
  if ! body="$(compose_layout "$name")"; then
    notify-send -u critical "Monitors" "The $name layout needs a screen that is not attached"
    return 1
  fi

  {
    echo "# AUTO-GENERATED by desktop-cmd-monitors-switch -- edit the script, not this."
    echo "# layout: $name"
    echo "# Generated on $(date)"
    echo
    echo "$body"
  } >"$CONF"

  hyprctl reload >/dev/null

  # The widest screen is a different one at every desk, so workspace 3 has to be
  # re-pinned against the monitors the reload just brought up -- not the old ones.
  desktop-workspace-pin

  notify-send "Monitors" "Applied the $name layout"
}

auto_layout() {
  local name body
  for name in "${LAYOUTS[@]}"; do
    body="$(compose_layout "$name")" || continue

    # Applying what is already in force would reload Hyprland and raise a notification
    # for nothing -- which is all a login would ever produce. It would also not settle:
    # applying a layout disables the screens it leaves out, and that disabling is itself
    # a monitor event, which desktop-monitors-watch would answer by applying again.
    [[ "$body" == "$(current_body)" ]] && return 0

    apply_layout "$name"
    return
  done
}

case "${1:-}" in
--list) list_layouts ;;
--current) current_layout ;;
"") auto_layout ;;
--*)
  echo "desktop-cmd-monitors-switch: unknown option $1" >&2
  exit 2
  ;;
*)
  if ! printf '%s\n' "${LAYOUTS[@]}" | grep -qx "$1"; then
    echo "desktop-cmd-monitors-switch: no layout named $1" >&2
    exit 2
  fi
  apply_layout "$1"
  ;;
esac
