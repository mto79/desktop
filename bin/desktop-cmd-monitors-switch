#!/usr/bin/env bash

# desktop-cmd-monitors-switch: apply a monitor layout.
#
#   desktop-cmd-monitors-switch           # the best layout for what is attached
#   desktop-cmd-monitors-switch <name>    # a named layout
#   desktop-cmd-monitors-switch --list    # layouts that could be applied right now
#   desktop-cmd-monitors-switch --current # the layout in force, if it was applied here
#
# ~/.config/hypr/monitors.conf is generated from whichever layout is chosen, so it is
# not a file to edit -- the layouts below are. A layout whose monitor is not plugged in
# is never listed and never chosen, and connectors are resolved by model at apply time,
# since DP-8 today can be DP-10 tomorrow.

set -euo pipefail

CONF="$HOME/.config/hypr/monitors.conf"
LAPTOP="${DESKTOP_LAPTOP_MONITOR:-eDP-1}"

WORK_MODEL="HP P34hc G4"
HOME_MODEL="LS34A650U"
HOME_LEFT_MODEL="LG Ultra HD"

MONITORS_JSON="$(hyprctl monitors all -j)"

connector_for_model() {
  jq -r --arg model "$1" 'first(.[] | select(.model == $model) | .name) // ""' <<<"$MONITORS_JSON"
}

attached_connectors() {
  jq -r '.[].name' <<<"$MONITORS_JSON"
}

# Each layout prints its monitor lines, or fails when its screens are not here.
layout_work() {
  local dock
  dock="$(connector_for_model "$WORK_MODEL")"
  [[ -n "$dock" ]] || return 1

  echo "monitor=$LAPTOP, 3840x2400@60, 2160x1440, 2"
  echo "monitor=$dock, 3440x1440@60, 2160x0, 1"
}

layout_home() {
  local main left
  main="$(connector_for_model "$HOME_MODEL")"
  left="$(connector_for_model "$HOME_LEFT_MODEL")"
  [[ -n "$main" ]] || return 1

  echo "monitor=$LAPTOP, 3840x2400@60, 2160x1440, 2"
  echo "monitor=$main, 3440x1440@60, 2160x0, 1"
  # The portrait screen is part of the desk but not required by it.
  [[ -n "$left" ]] && echo "monitor=$left, 3840x2160@60, 0x0, 1, transform, 1"
}

layout_laptop() {
  echo "monitor=$LAPTOP, 3840x2400@60, 2160x1440, 2"
}

LAYOUTS=(work home laptop)

list_layouts() {
  local name
  for name in "${LAYOUTS[@]}"; do
    "layout_$name" >/dev/null 2>&1 && echo "$name"
  done
}

current_layout() {
  [[ -f "$CONF" ]] || return 0
  sed -n 's/^# layout: //p' "$CONF" | head -1
}

apply_layout() {
  local name="$1"
  local lines
  if ! lines="$("layout_$name" 2>/dev/null)"; then
    notify-send -u critical "Monitors" "The $name layout needs a screen that is not attached"
    return 1
  fi

  local used connector
  used=$(cut -d, -f1 <<<"$lines" | sed 's/^monitor=//')

  {
    echo "# AUTO-GENERATED by desktop-cmd-monitors-switch -- edit the script, not this."
    echo "# layout: $name"
    echo "# Generated on $(date)"
    echo
    echo "$lines"

    # Anything attached and unused is turned off explicitly. Without this a monitor
    # keeps whatever the previous layout gave it, and switching desks leaves a screen
    # sitting in a position that belongs to the other one.
    for connector in $(attached_connectors); do
      grep -qx "$connector" <<<"$used" || echo "monitor=$connector, disable"
    done
  } >"$CONF"

  hyprctl reload >/dev/null
  notify-send "Monitors" "Applied the $name layout"
}

auto_layout() {
  local name
  for name in "${LAYOUTS[@]}"; do
    if "layout_$name" >/dev/null 2>&1; then
      apply_layout "$name"
      return
    fi
  done
}

case "${1:-}" in
--list) list_layouts ;;
--current) current_layout ;;
"") auto_layout ;;
--*)
  echo "desktop-cmd-monitors-switch: unknown option $1" >&2
  exit 2
  ;;
*)
  if ! printf '%s\n' "${LAYOUTS[@]}" | grep -qx "$1"; then
    echo "desktop-cmd-monitors-switch: no layout named $1" >&2
    exit 2
  fi
  apply_layout "$1"
  ;;
esac
