#!/usr/bin/env bash

# desktop-agent-prompt: ask a coding agent something, from anywhere.
#
#   desktop-agent-prompt              # ask for the agent, then the prompt, then run it
#   desktop-agent-prompt "review this"
#
# Without DESKTOP_AGENT a menu of the three agents opens, defaulting to claude, so the
# same key reaches whichever one you were about to work with. The agent runs in a
# floating terminal in the directory of the focused window, so "explain this file"
# lands in the project you were looking at rather than in $HOME.

set -uo pipefail

AGENT="${DESKTOP_AGENT:-}"
if [[ -z "$AGENT" ]]; then
  AGENT=$(printf 'claude\nopencode\ncodex\n' | desktop-menu-select --prompt "Ask which agent" --select claude) || exit 0
fi

PROMPT="${*:-}"
if [[ -z "$PROMPT" ]]; then
  PROMPT=$(desktop-menu-input --prompt "Ask $AGENT") || exit 0
fi

[[ -n "$PROMPT" ]] || exit 0

# The focused window's working directory, when it has one worth using. A terminal's own
# shell is the common case; anything else falls back to $HOME.
cwd="$HOME"
pid=$(hyprctl activewindow -j | jq -r '.pid // empty')
if [[ -n "$pid" ]]; then
  # The deepest child holding a cwd is the shell inside the terminal, not the terminal.
  for child in $(pgrep -P "$pid" 2>/dev/null) "$pid"; do
    candidate=$(readlink "/proc/$child/cwd" 2>/dev/null) || continue
    [[ -d "$candidate" ]] && cwd="$candidate" && break
  done
fi

# Each agent takes a first message its own way: claude and codex as a positional,
# opencode through its TUI's --prompt (its positional is a project path, not a message).
ARGS=("$AGENT")
case "$AGENT" in
opencode) ARGS+=(--prompt "$PROMPT") ;;
*) ARGS+=("$PROMPT") ;;
esac

# Through desktop-agent so a crash is announced, and with desktop-show-done after it so
# the window survives the agent: an agent that exits immediately -- unauthenticated, a
# bad flag, anything -- used to take its own error message off the screen with it.
exec setsid uwsm app -- ghostty --title="Agent $AGENT" \
  --working-directory="$cwd" \
  -e bash -c 'desktop-agent "$@"; desktop-show-done' _ "${ARGS[@]}"
