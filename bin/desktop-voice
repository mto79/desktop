#!/usr/bin/env bash

# desktop-voice: say what you want the desktop to do.
#
#   desktop-voice toggle        # SUPER + C: listen, and act when you stop talking
#   desktop-voice run "text"    # act on a sentence as if it had been said
#   desktop-voice list          # what it understands
#   desktop-voice model         # which model is asked when the list does not know
#   desktop-voice mode [local|vpn|cloud]   # how far a sentence may travel
#   desktop-voice learned       # what it has learned, and what it could not make out
#   desktop-voice forget|teach|edit        # prune it, or say what a phrase means yourself
#   desktop-voice key           # store the Anthropic key for cloud mode in the keyring
#
# Dictation types what you say. This does what you say, from a list: "workspace three",
# "lock the screen", "k9s on ocp204", "what is waiting", "tell desktop to run the tests".
#
# A list, on purpose. Speech is misheard, and what is done with a misheard sentence
# decides how bad that is. Here it can only ever become one of the things below or
# nothing at all: there is no path from what was heard to a shell. The things that cannot
# be undone -- restart, shut down, log out -- are not on the list; they stay on SUPER +
# ESCAPE, which asks twice. And what is said *to an agent* is typed into its prompt and
# left there for you to read and send: an agent acts on what it is told, with your
# permissions, and "run the tests" heard as something else should cost a glance, not a
# repository.
#
# A key of its own rather than a word spoken into the dictation key, so that what is said
# to it is never typed. The recording and the transcription are the dictation daemon's:
# it is asked to write what it hears to a file this once (voxtype record start --file).
# That is what makes an answer take a second and not four -- the daemon has the model
# loaded already, where transcribing a recording from the command line loads it afresh
# every time. Only when the daemon is not running is that slower way used.

set -uo pipefail

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/desktop/voice"
SAY_DIR="${XDG_RUNTIME_DIR:-/tmp}/desktop/say"
MAX_SECONDS="${DESKTOP_VOICE_MAX_SECONDS:-8}"
# The model asked what a sentence means when the list below does not know it. "off" for
# none. Small on purpose: it has to fit on the graphics card beside the recogniser.
MODEL="${DESKTOP_VOICE_MODEL:-qwen2.5:3b}"
OLLAMA="${DESKTOP_VOICE_OLLAMA:-http://127.0.0.1:11434}"

# A better model somewhere else, asked first when it can be reached -- a large one on a
# server that is only there while a VPN is up, say. It is this machine's own business
# where that is and what the key is, so it is not written in this repository:
#
#   ~/.config/desktop/voice.conf
#     remote_url=https://llm.example.org        # an OpenAI-compatible API; /chat/completions is added
#     remote_model=Qwen/Qwen3.8-27B
#     remote_key_file=~/.config/desktop/voice.key
#
# Reachable is decided by whether its name resolves, which costs nothing when it does not.
# When it cannot be reached, or does not answer, the model on this machine is asked.
CONF="${DESKTOP_VOICE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/desktop/voice.conf}"
conf() { # key -> value
  [[ -r $CONF ]] || return 0
  sed -n -E "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//' | tail -1
}
REMOTE_URL=$(conf remote_url)
REMOTE_URL=${REMOTE_URL%/}
REMOTE_MODEL=$(conf remote_model)
REMOTE_KEY_FILE=$(conf remote_key_file)
REMOTE_KEY_FILE=${REMOTE_KEY_FILE/#\~/$HOME}

# How far a sentence may travel, chosen by you (desktop-voice mode, or the AI panel) and
# kept across a reboot:
#
#   local   never off this machine
#   vpn     the model in voice.conf when it is in reach, else local      (the default)
#   cloud   Claude Haiku at Anthropic first -- the cleverest, and the furthest away
#
# Cloud is hedged about, since it is the one that leaves the building:
#   - only a sentence the list does not know goes at all, as with any model
#   - the sentence goes alone: no window title, no agent names, no last command
#   - a sentence naming a cluster or one of your running projects stays local
#   - what comes back is one name from the fixed set, through the list, like the others
#   - the key lives in the keyring, never in a file here, never on a command line
#   - every sentence sent is written to ~/.local/state/desktop/voice/sent.log
#   - and the card says so, in red, every time
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/voice"
CLOUD_MODEL="${DESKTOP_VOICE_CLOUD_MODEL:-claude-haiku-5-5}"
CLOUD_URL="${DESKTOP_VOICE_CLOUD_URL:-https://api.anthropic.com/v1/messages}"

mode() {
  local m
  m=$(cat "$STATE_DIR/mode" 2>/dev/null)
  [[ $m =~ ^(local|vpn|cloud)$ ]] && echo "$m" || echo vpn
}

cloud_key() { secret-tool lookup service desktop-voice account anthropic 2>/dev/null; }
cloud_ready() { [[ $(mode) == cloud && $MODEL != off ]] && [[ -n $(cloud_key) ]]; }

# A sentence that must not go to the cloud whatever the mode: it names a cluster, or one
# of the projects an agent is working on.
stays_home() { # the sentence
  local said projects
  said=$(normalise "$1")
  [[ $said =~ ocp[0-9]{3} ]] && return 0
  projects=$(desktop-agent-sessions --json 2>/dev/null | jq -r '[.sessions[]?.project // empty] | unique | .[]' 2>/dev/null | tr '[:upper:]-_' '[:lower:]  ')
  local project
  while IFS= read -r project; do
    [[ ${#project} -ge 3 && " $said " == *" $project "* ]] && return 0
  done <<<"$projects"
  return 1
}

# Whether the model on your own network is there to be asked, whatever the mode: the
# buttons show it as available or not, and "not available" must not mean "not chosen".
remote_there() {
  [[ -n $REMOTE_URL && -n $REMOTE_MODEL ]] || return 1
  local host=${REMOTE_URL#*://}
  host=${host%%[:/]*}
  getent hosts "$host" >/dev/null 2>&1
}

# Whether a sentence would go there: it is there, and the mode lets it.
remote_reachable() {
  [[ $(mode) != local && $MODEL != off ]] || return 1
  remote_there
}

# Which model a sentence goes to, where everybody can see it: the cards read this file.
# "where" is remote (it leaves this machine), local, or none (the list only).
note_model() { # name where
  mkdir -p "$RUN_DIR" 2>/dev/null || return 0
  # A name of its own for the half-written file: the shell asks at the same moments.
  jq -cn --arg name "$1" --arg where "$2" '{name: $name, where: $where}' >"$RUN_DIR/model.$$" 2>/dev/null &&
    mv -f "$RUN_DIR/model.$$" "$RUN_DIR/model"
}

# What it has learned, and what you have told it.
#
# A sentence a model made sense of is remembered with what it turned out to mean, and
# the next time it is said it is simply known: at once, and with nothing asked of any
# model -- so a sentence goes to the cloud once at most. That is a guess kept, and a
# guess can be wrong, so the list is yours to see and to prune: on the dashboard, or
#
#   desktop-voice learned              what it knows, and what it could not make out
#   desktop-voice forget "<phrase>"    drop one
#   desktop-voice teach "<phrase>" "<command>"    say what a phrase means yourself
#   desktop-voice edit                 your own phrases, in an editor
#
# Yours are in ~/.config/desktop/voice.aliases, one "phrase = command" a line, and win
# over what was learned. Either way the command is a sentence the list knows and goes
# through the list like anything said: nothing here can make it do what it would refuse.
ALIASES="${DESKTOP_VOICE_ALIASES:-${XDG_CONFIG_HOME:-$HOME/.config}/desktop/voice.aliases}"
LEARNED="$STATE_DIR/learned.tsv"
MISSED="$STATE_DIR/missed.tsv"

# Anything that changes what the shell shows tells it so: it watches this file.
changed() { mkdir -p "$RUN_DIR" 2>/dev/null && date +%s%N >"$RUN_DIR/changed"; }

known_as() { # normalised phrase -> the command it stands for, or nothing
  local phrase=$1 line key
  if [[ -r $ALIASES ]]; then
    while IFS= read -r line; do
      [[ $line =~ ^[[:space:]]*# || $line != *=* ]] && continue
      key=$(normalise "${line%%=*}")
      if [[ $key == "$phrase" ]]; then
        sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' <<<"${line#*=}"
        return 0
      fi
    done <"$ALIASES"
  fi
  [[ ${DESKTOP_VOICE_LEARN:-on} != off && -r $LEARNED ]] && awk -F'\t' -v p="$phrase" '$1 == p { print $2; found = 1; exit } END { exit !found }' "$LEARNED"
}

learn() { # normalised phrase, command, who made sense of it
  # DESKTOP_VOICE_LEARN=off: every sentence is put to the model afresh, and none is kept.
  [[ ${DESKTOP_VOICE_LEARN:-on} != off ]] || return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  { [[ -r $LEARNED ]] && awk -F'\t' -v p="$1" '$1 != p' "$LEARNED"; printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(date '+%F %H:%M')"; } >"$LEARNED.$$" &&
    mv -f "$LEARNED.$$" "$LEARNED"
  unmiss "$1"
  changed
}

missed() { # what was heard
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  local phrase
  phrase=$(normalise "$1")
  [[ -n $phrase ]] || return 0
  { [[ -r $MISSED ]] && awk -F'\t' -v p="$phrase" '$1 != p' "$MISSED" | tail -29; printf '%s\t%s\n' "$phrase" "$(date '+%F %H:%M')"; } >"$MISSED.$$" &&
    mv -f "$MISSED.$$" "$MISSED"
  changed
}

unmiss() { [[ -r $MISSED ]] && awk -F'\t' -v p="$1" '$1 != p' "$MISSED" >"$MISSED.$$" && mv -f "$MISSED.$$" "$MISSED"; }

forget() { # phrase
  local phrase
  phrase=$(normalise "$1")
  [[ -r $LEARNED ]] && awk -F'\t' -v p="$phrase" '$1 != p' "$LEARNED" >"$LEARNED.$$" && mv -f "$LEARNED.$$" "$LEARNED"
  unmiss "$phrase"
  if [[ -r $ALIASES ]]; then
    local line keep=()
    while IFS= read -r line; do
      [[ ! $line =~ ^[[:space:]]*# && $line == *=* && $(normalise "${line%%=*}") == "$phrase" ]] || keep+=("$line")
    done <"$ALIASES"
    printf '%s\n' "${keep[@]}" >"$ALIASES.$$" && mv -f "$ALIASES.$$" "$ALIASES"
  fi
  changed
}

teach() { # phrase, command
  local phrase command
  phrase=$(normalise "$1")
  command=$(tr -d '\n=' <<<"$2" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  [[ -n $phrase && -n $command ]] || { echo "usage: desktop-voice teach \"<phrase>\" \"<command>\"" >&2; return 2; }
  forget "$phrase"
  mkdir -p "$(dirname "$ALIASES")" && [[ -e $ALIASES ]] || printf '%s\n' "# What a phrase means, for desktop-voice: phrase = command" \
    "# The command is anything from: desktop-voice list" >"$ALIASES"
  printf '%s = %s\n' "$phrase" "$command" >>"$ALIASES"
  changed
}

# Everything the shell shows about the voice, in one answer, and nothing written.
state_json() {
  local name where
  IFS=$'\t' read -r name where < <(model_now)
  jq -cn --arg mode "$(mode)" --arg name "$name" --arg where "$where" \
    --argjson key "$([[ -n $(cloud_key) ]] && echo true || echo false)" \
    --argjson vpn "$([[ -n $REMOTE_URL ]] && echo true || echo false)" \
    --argjson reachable "$(remote_there && echo true || echo false)" \
    --arg remote "$REMOTE_MODEL" --arg cloud "$CLOUD_MODEL" --arg local "$MODEL" \
    --rawfile learned <(cat "$LEARNED" 2>/dev/null) --rawfile missed <(cat "$MISSED" 2>/dev/null) \
    --rawfile aliases <(grep -v '^[[:space:]]*#' "$ALIASES" 2>/dev/null | grep '=') '
    {mode: $mode, name: $name, where: $where, cloud_key: $key, vpn_configured: $vpn, vpn_reachable: $reachable,
     models: {local: $local, vpn: $remote, cloud: $cloud},
     yours: [$aliases | split("\n")[] | select(. != "") | {phrase: (.[: index("=")] | gsub("^\\s+|\\s+$"; "")), command: (.[index("=") + 1 :] | gsub("^\\s+|\\s+$"; ""))}],
     learned: ([$learned | split("\n")[] | select(. != "") | split("\t") | {phrase: .[0], command: .[1], by: .[2], when: .[3]}] | reverse),
     missed: ([$missed | split("\n")[] | select(. != "") | split("\t") | {phrase: .[0], when: .[1]}] | reverse)}'
}

# The one that would be asked now.
model_now() { # -> "name<TAB>where"
  if cloud_ready; then
    printf '%s\t%s\n' "$CLOUD_MODEL" cloud
  elif remote_reachable; then
    printf '%s\t%s\n' "$REMOTE_MODEL" remote
  elif [[ $MODEL != off ]] && curl -sf --max-time 1 "$OLLAMA/api/version" >/dev/null 2>&1; then
    printf '%s\t%s\n' "$MODEL" local
  else
    printf '%s\t%s\n' "" none
  fi
}

# The card desktop-say shows while it speaks is the natural place to say "listening" and
# then what was understood. The same file, the same shape.
show() { # state text [seconds to leave it]
  mkdir -p "$SAY_DIR" 2>/dev/null || return 0
  jq -cn --arg state "$1" --arg text "$2" '{state: $state, text: $text}' >"$SAY_DIR/now.part" 2>/dev/null &&
    mv -f "$SAY_DIR/now.part" "$SAY_DIR/now"
  if [[ -n ${3:-} ]]; then
    (sleep "$3"; [[ $(jq -r .text "$SAY_DIR/now" 2>/dev/null) == "$2" ]] && rm -f "$SAY_DIR/now") >/dev/null 2>&1 &
    disown 2>/dev/null
  fi
}

# What happened, where it can be seen for a moment.
did() { show speaking "$1" 3; }
could_not() { show preparing "$1" 4; }

shell_call() { desktop-shell shell "$@" >/dev/null 2>&1; }
terminal() { setsid -f uwsm app -- ghostty -e "$@" >/dev/null 2>&1; }

# What was heard, made comparable: lower case, no punctuation, numbers as digits, and a
# cluster's name back in one piece -- it is heard as "OCP 204" or "o c p two oh four".
normalise() {
  local text
  text=$(tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E "s/[.,!?;:\"“”]+/ /g; s/[’']//g")
  text=$(sed -E '
    s/\bzero\b/0/g; s/\bone\b/1/g; s/\btwo\b/2/g; s/\bthree\b/3/g; s/\bfour\b/4/g; s/\bfive\b/5/g
    s/\bsix\b/6/g; s/\bseven\b/7/g; s/\beight\b/8/g; s/\bnine\b/9/g; s/\bten\b/10/g; s/\boh\b/0/g
    s/\bo ?c ?p ?([0-9]) ?([0-9]) ?([0-9])\b/ocp\1\2\3/g
    s/[[:space:]]+/ /g; s/^ //; s/ $//' <<<"$text")
  printf '%s' "$text"
}

# The window whose class or title has every word asked for, most recently used first.
window_named() { # words...
  hyprctl clients -j 2>/dev/null | jq -r --arg want "$*" '
    ($want | ascii_downcase | split(" ") | map(select(. != ""))) as $words
    | [.[] | select(.mapped != false)
        | select(((.class + " " + .title) | ascii_downcase) as $text | all($words[]; . as $w | $text | contains($w)))]
    | sort_by(.focusHistoryID) | first | .address // empty'
}

# The agent working on a project, by as much of its name as was said.
agent_for() { # words... -> "pane<TAB>socket<TAB>project<TAB>target"
  desktop-agent-sessions --json 2>/dev/null | jq -r --arg want "$*" '
    ($want | ascii_downcase | gsub("[^a-z0-9]+"; " ") | split(" ") | map(select(. != ""))) as $words
    | [.sessions[]? | select((.pane // "") != "")
        | select((.project | ascii_downcase | gsub("[^a-z0-9]+"; " ")) as $name | all($words[]; . as $w | $name | contains($w)))]
    | first | select(.) | [.pane, (.socket // ""), .project, (.target // "")] | @tsv'
}

# The agent in front of you: the one in the AI column of the tmux window you are in, or
# failing that the one whose tab you looked at last. What "it" means in "tell it to ...".
agent_here() { # -> "pane<TAB>socket<TAB>project<TAB>target"
  local group session
  group=$(tmux list-panes -F '#{@ai_column}' 2>/dev/null | grep -m1 .)
  session=$(tmux list-clients -F '#{client_session}' 2>/dev/null | awk -v g="ai-$group-" 'g != "ai--" && index($0, g) == 1 { print; exit }')
  desktop-agent-sessions --json 2>/dev/null | jq -r --arg session "$session" '
    [.sessions[]? | select((.pane // "") != "")] as $all
    | ([$all[] | select($session != "" and ((.target // "") | startswith($session + ":")))] | first)
      // ($all | sort_by(.since) | last)
    | select(.) | [.pane, (.socket // ""), .project, (.target // "")] | @tsv'
}

tell_agent() { # project words, then what to tell it
  local who=$1 what=$2 pane socket project target
  # "it", "this one", "the agent": the one in front of you, not one called "it".
  if [[ $who =~ ^(it|him|her|this|this one|that|the agent|this agent|claude)$ ]]; then
    IFS=$'\t' read -r pane socket project target < <(agent_here)
    who="the agent here"
  else
    IFS=$'\t' read -r pane socket project target < <(agent_for "$who")
  fi
  if [[ -z ${pane:-} ]]; then
    could_not "No agent is working on “$who”"
    return 1
  fi
  # Typed, not sent. Enter is yours: it is the look at what was actually heard.
  tmux ${socket:+-S "$socket"} send-keys -t "$pane" -l -- "$what" 2>/dev/null || {
    could_not "Could not reach the agent on $project"
    return 1
  }
  [[ -n $target ]] && setsid -f desktop-menu-agents --jump "$target" "$socket" >/dev/null 2>&1
  did "For $project, press Enter to send: $what"
}

# The patterns have spaces in them, which a bare regular expression inside [[ ]] cannot:
# each is a quoted string handed to this. What matched is in BASH_REMATCH afterwards.
is() { [[ $said =~ $1 ]]; }

# What was done last, so that "again" has something to mean. Only things that can be done
# twice without thinking: not a message to an agent, and nothing that was refused.
remember() { mkdir -p "$RUN_DIR" 2>/dev/null && printf '%s\n' "$1" >"$RUN_DIR/last"; }

# The first of the things that are waiting, said and gone to.
go_to_waiting() {
  local target socket project
  IFS=$'\t' read -r target socket project < <(desktop-agent-sessions --json 2>/dev/null |
    jq -r '[.sessions[]? | select(.state == "waiting" and (.target // "") != "")] | first | select(.) | [.target, (.socket // ""), .project] | @tsv')
  if [[ -z ${target:-} ]]; then
    did "No agent is waiting"
    return 0
  fi
  setsid -f desktop-menu-agents --jump "$target" "$socket" >/dev/null 2>&1
  did "$project is waiting"
}

# A few headlines, read out. From what the dashboard already fetched: this asks nobody.
headlines() { # words naming a site or a heading, or nothing
  local want=$1 lines
  lines=$(desktop-dash news --json 2>/dev/null | jq -r --arg want "$want" '
    ($want | ascii_downcase) as $w
    | ([.feeds[]? | select(.ok)]) as $feeds
    | ([$feeds[] | select($w != "" and ((.name | ascii_downcase | contains($w)) or (.category == $w)))] | first) // $feeds[0]
    | select(.) | "\(.name). " + ([.items[0:3][].title] | join(". ")) + "."')
  if [[ -z $lines ]]; then
    could_not "There are no headlines to read"
    return 1
  fi
  show speaking "$lines" 12
  desktop-say "$lines"
}

# A sentence the list does not know, put to a small model running on this machine -- and
# what comes back is not done. It is one name out of a fixed set and a word or two to go
# with it, and from those a sentence is made here that the list *does* know, which then
# goes through the list like anything said. So the model widens what can be said and
# nothing else: it cannot add an action, it cannot reach a shell, and what is refused when
# said plainly is refused when it is the model that says it. Two things are kept from it
# altogether: a message to an agent, whose words must be yours and not a paraphrase, and
# emptying the notification centre, which cannot be undone and should not be guessed at.
#
# It is told what is in front of you, so that "the other screen" or "that cluster" has
# something to mean: the focused window, the workspace, the agents running, what was
# done last.
understand() { # the sentence -> a sentence the list knows, or nothing
  [[ $MODEL != off ]] && command -v curl >/dev/null 2>&1 || return 1
  local heard=$1 window workspace agents last request answer action arg
  window=$(hyprctl activewindow -j 2>/dev/null | jq -r '"\(.class // "") - \(.title // "")"' 2>/dev/null | cut -c1-80)
  workspace=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' 2>/dev/null)
  agents=$(desktop-agent-sessions --json 2>/dev/null | jq -r '[.sessions[]? | "\(.project) (\(.state))"] | unique | join(", ")' 2>/dev/null)
  last=$(cat "$RUN_DIR/last" 2>/dev/null)

  request=$(jq -cn --arg model "$MODEL" --arg heard "$heard" --arg window "$window" --arg workspace "$workspace" \
    --arg agents "$agents" --arg last "$last" '{
      model: $model, stream: false, keep_alive: "10m",
      options: {temperature: 0, num_predict: 48},
      format: {type: "object", required: ["action", "arg"], properties: {arg: {type: "string"}, action: {type: "string", enum: [
        "workspace", "dashboard", "lock", "overview", "launcher", "notifications", "do_not_disturb", "brief", "time",
        "louder", "quieter", "mute", "hush", "voice_off", "voice_on", "screenshot", "focus", "shell", "k9s", "argo",
        "waiting_agent", "start_task", "finish_task", "news", "headlines", "clusters", "behind", "voice", "none"]}}},
      messages: [
        {role: "system", content: ("You turn one spoken sentence, in English or Dutch, into one action for a Linux desktop. Speech recognition makes mistakes; go by what was most likely meant. Answer with JSON: an action and its arg (\"\" when it takes none). When nothing fits, or it asks to restart, shut down, log out, delete or run a command, the action is none.\n\nActions:\n"
          + "workspace: go to a workspace; arg is its number 1-10\n"
          + "dashboard: show the dashboard; arg is one of start, domotics, infrastructure, health, finance, watching, news, or empty\n"
          + "lock: lock the screen\noverview: show all windows and workspaces\nlauncher: open the application launcher\n"
          + "notifications: show the notifications\ndo_not_disturb: toggle do not disturb\n"
          + "brief: say what is waiting or needs attention\ntime: say the time\n"
          + "louder / quieter / mute: the sound volume\nhush: stop talking now\nvoice_off / voice_on: turn the spoken voice off or on\n"
          + "screenshot: take a screenshot\nfocus: switch to an open application window; arg is its name, e.g. firefox\n"
          + "shell / k9s / argo: open a shell, k9s, or Argo CD on an OpenShift cluster; arg is the cluster like ocp204\n"
          + "waiting_agent: go to the coding agent that is waiting\n"
          + "start_task: start a new coding task; arg is its name\nfinish_task: finish the current coding task\n"
          + "news: show news; arg is tech or world\nheadlines: read headlines aloud; arg is a site or tech or world, or empty\n"
          + "clusters: say which clusters are in trouble\nbehind: say which software has a newer version\n"
          + "voice: change the speaking voice; arg is the voice name\nnone: anything else, including questions about the world\n\n"
          + "Examples:\n"
          + "switch over to the second desktop -> {\"action\":\"workspace\",\"arg\":\"2\"}\n"
          + "show me my bank balance -> {\"action\":\"dashboard\",\"arg\":\"finance\"}\n"
          + "how did I sleep -> {\"action\":\"dashboard\",\"arg\":\"health\"}\n"
          + "turn it down a little -> {\"action\":\"quieter\",\"arg\":\"\"}\n"
          + "that is enough talking -> {\"action\":\"hush\",\"arg\":\"\"}\n"
          + "does anybody need me -> {\"action\":\"brief\",\"arg\":\"\"}\n"
          + "take me to the agent that wants an answer -> {\"action\":\"waiting_agent\",\"arg\":\"\"}\n"
          + "k nines on o c p one oh one -> {\"action\":\"k9s\",\"arg\":\"ocp101\"}\n"
          + "let us start fixing the broken tests -> {\"action\":\"start_task\",\"arg\":\"broken tests\"}\n"
          + "this task is finished -> {\"action\":\"finish_task\",\"arg\":\"\"}\n"
          + "zet het geluid harder -> {\"action\":\"louder\",\"arg\":\"\"}\n"
          + "who won the world cup -> {\"action\":\"none\",\"arg\":\"\"}")},
        {role: "user", content: ("Focused window: \($window)\nWorkspace: \($workspace)\nCoding agents: \($agents)\nLast command: \($last)\n\nSentence: \($heard)")}
      ]}')
  # The better model first, where there is one in reach. The same question in the shape
  # an OpenAI-compatible server wants, the key from its file and never on a command line.
  answer=""
  if cloud_ready && ! stays_home "$heard"; then
    # The same instructions, and the sentence with nothing beside it. Thinking is off and
    # the answer is held to the same schema: this is a choice out of a list, quickly.
    mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$CLOUD_MODEL" "$heard" >>"$STATE_DIR/sent.log"
    answer=$(jq -c --arg model "$CLOUD_MODEL" --arg heard "$heard" '{model: $model, max_tokens: 256,
        thinking: {type: "disabled"},
        output_config: {effort: "low", format: {type: "json_schema", schema: (.format + {additionalProperties: false})}},
        system: .messages[0].content,
        messages: [{role: "user", content: ("Sentence: " + $heard)}]}' <<<"$request" |
      curl -sf --connect-timeout 2 --max-time "${DESKTOP_VOICE_MODEL_SECONDS:-8}" "$CLOUD_URL" \
        -H 'Content-Type: application/json' -H 'anthropic-version: 2023-06-01' \
        -K <(printf 'header = "x-api-key: %s"\n' "$(cloud_key)") -d @- 2>/dev/null |
      # A refusal, or anything but a finished answer, is no answer.
      jq -r 'select(.stop_reason == "end_turn") | [.content[]? | select(.type == "text") | .text] | join("")' 2>/dev/null)
    [[ -n $answer ]] && note_model "$CLOUD_MODEL" cloud
  fi
  if [[ -z $answer ]] && remote_reachable; then
    answer=$(jq -c --arg model "$REMOTE_MODEL" '{model: $model, temperature: 0, max_tokens: 1200, messages: .messages,
        chat_template_kwargs: {enable_thinking: false},
        response_format: {type: "json_schema", json_schema: {name: "action", strict: true, schema: .format}}}' <<<"$request" |
      curl -sf --connect-timeout 2 --max-time "${DESKTOP_VOICE_MODEL_SECONDS:-8}" "$REMOTE_URL/chat/completions" \
        -H 'Content-Type: application/json' -K <([[ -r $REMOTE_KEY_FILE ]] && printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '[:space:]' <"$REMOTE_KEY_FILE")") \
        -d @- 2>/dev/null |
      # A model that thinks aloud first: what counts is the object at the end of it.
      jq -r '.choices[0].message.content // empty' 2>/dev/null | tr '\n' ' ' | grep -oE '\{[^{}]*\}' | tail -1)
    [[ -n $answer ]] && note_model "$REMOTE_MODEL" remote
  fi
  if [[ -z $answer ]]; then
    answer=$(curl -sf --max-time "${DESKTOP_VOICE_MODEL_SECONDS:-8}" "$OLLAMA/api/chat" -d "$request" 2>/dev/null | jq -r '.message.content // empty' 2>/dev/null) || return 1
    [[ -n $answer ]] && note_model "$MODEL" local
  fi
  action=$(jq -r '.action // "none"' <<<"$answer" 2>/dev/null)
  # Whatever came back as the arg is only ever letters, digits, spaces and dashes.
  arg=$(jq -r '.arg // ""' <<<"$answer" 2>/dev/null | tr '[:upper:]_' '[:lower:] ' | tr -cd 'a-z0-9 -' | cut -c1-60 | sed -E 's/^ +//; s/ +$//')

  case $action in
  workspace) [[ $arg =~ ^[0-9]+$ ]] && echo "workspace $arg" ;;
  dashboard) [[ $arg =~ ^(start|domotics|infrastructure|health|finance|watching|news)$ ]] && echo "dashboard $arg" || echo "dashboard" ;;
  lock) echo "lock the screen" ;;
  overview) echo "overview" ;;
  launcher) echo "launcher" ;;
  notifications) echo "notifications" ;;
  do_not_disturb) echo "do not disturb" ;;
  brief) echo "status" ;;
  time) echo "what time is it" ;;
  louder | quieter | mute | hush) echo "$action" ;;
  voice_off) echo "voice off" ;;
  voice_on) echo "voice on" ;;
  screenshot) echo "screenshot" ;;
  focus) [[ -n $arg ]] && echo "go to $arg" ;;
  shell | k9s | argo) [[ ${arg// /} =~ ^ocp[0-9]{3}$ ]] && echo "$action on ${arg// /}" ;;
  waiting_agent) echo "go to the waiting agent" ;;
  start_task) [[ -n $arg ]] && echo "start a task called $arg" ;;
  finish_task) echo "finish the task" ;;
  news) [[ $arg =~ ^(tech|world)$ ]] && echo "$arg news" ;;
  headlines) echo "read the ${arg:+$arg }headlines" ;;
  clusters) echo "cluster status" ;;
  behind) echo "what is behind" ;;
  voice) [[ -n $arg ]] && echo "use voice $arg" ;;
  esac
}

# The model, loaded while you are still talking. It leaves the graphics card ten minutes
# after it was last wanted, and loading it again takes a few seconds -- which is about as
# long as a sentence. Asked for nothing; only to be there.
warm_model() {
  [[ $MODEL != off ]] && command -v curl >/dev/null 2>&1 || return 0
  local name where
  IFS=$'\t' read -r name where < <(model_now)
  note_model "$name" "$where"
  # The one elsewhere is somebody else's to keep loaded.
  [[ $where == local ]] || return 0
  (curl -sf --max-time 30 "$OLLAMA/api/generate" -d "$(jq -cn --arg model "$MODEL" '{model: $model, keep_alive: "10m"}')" >/dev/null 2>&1 &)
}

# The list did not know it: the model is asked once, and its answer goes through the list.
second_try() { # what was heard, and what to say if this comes to nothing
  local heard=$1 otherwise=$2 meant
  if [[ -z ${ASKED_MODEL:-} && $MODEL != off ]]; then
    show preparing "…"
    meant=$(understand "$heard")
    if [[ -n $meant ]]; then
      # Kept, when it led somewhere: said again, it is known without asking anybody.
      if ASKED_MODEL=1 interpret "$meant"; then
        learn "$(normalise "$heard")" "$meant" "$(jq -r '.name // "a model"' "$RUN_DIR/model" 2>/dev/null)"
        return 0
      fi
      return 1
    fi
  fi
  [[ -z ${ASKED_MODEL:-} ]] && missed "$heard"
  could_not "$otherwise"
  return 1
}

interpret() { # the sentence
  local said heard cluster number
  heard=$1
  said=$(normalise "$1")

  # "Again": whatever was done last, done once more.
  if [[ $said =~ ^(again|repeat|repeat that|do that again|once more|same again)$ ]]; then
    if [[ -s $RUN_DIR/last ]]; then
      heard=$(cat "$RUN_DIR/last")
      said=$(normalise "$heard")
    else
      could_not "There is nothing to do again"
      return 1
    fi
  fi
  [[ -n $said ]] || {
    could_not "Nothing was heard"
    return 1
  }

  # A phrase you taught it, or one it learned: it stands for a sentence the list knows.
  if [[ -z ${KNOWN_AS:-} ]]; then
    local stands_for
    stands_for=$(known_as "$said")
    if [[ -n $stands_for ]]; then
      KNOWN_AS=1 interpret "$stands_for"
      return
    fi
  fi

  # Not from here, however clearly it was said.
  if is '(reboot|restart the|shut ?down|power ?off|log ?out|sign ?out|suspend|hibernate)'; then
    could_not "That one needs the keyboard: Super + Escape"
    return 1
  fi

  # To an agent. First, because what follows "tell" is free text and must not be read as
  # a command of its own -- "tell desktop to lock the door" is not "lock".
  if is '^(tell|ask) (.+)$'; then
    # Who is everything up to the first "to" -- "idrac security" is two words -- and
    # what to tell it is the rest. Taken from what was heard, not from the normalised
    # text: the capitals and the punctuation of a message are part of it.
    local rest who what
    rest=$(sed -E 's/^[[:space:]]*(tell|ask)[[:space:]]+//I' <<<"$heard")
    if grep -qiE '[[:space:]]to[[:space:]]' <<<"$rest"; then
      who=$(awk 'BEGIN { IGNORECASE = 1 } { i = match($0, /[[:space:]]to[[:space:]]/); print substr($0, 1, i - 1) }' <<<"$rest")
      what=$(awk 'BEGIN { IGNORECASE = 1 } { i = match($0, /[[:space:]]to[[:space:]]/); print substr($0, i + RLENGTH) }' <<<"$rest")
    else
      who=${rest%% *}
      what=${rest#* }
    fi
    tell_agent "$(normalise "$who")" "$what"
    return
  fi

  if is '(workspace|desktop) ([0-9]+)$'; then
    number=${BASH_REMATCH[2]}
    hyprctl dispatch "hl.dsp.focus({ workspace = $number })" >/dev/null 2>&1 && did "Workspace $number"
  elif is '(dashboard|show|open)( the)? (start|ai|assistant|domotics|home|house|infrastructure|clusters|health|finance|money|watching|versions|news|headlines)( tab| page)?$'; then
    # A tab of the dashboard, by its subject or the word you would use for it.
    local subject=${BASH_REMATCH[3]} key
    case "$subject" in
    assistant) key=ai ;; domotics | house) key=home ;; infrastructure | clusters) key=infra ;; money) key=finance ;;
    watching | versions) key=watch ;; headlines) key=news ;; *) key=$subject ;;
    esac
    shell_call dashboardTab "$key"
    # The clusters share their tab with the network; asked for by name, they are shown.
    [[ $subject == clusters ]] && shell_call infraSection clusters
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "Dashboard: $subject"
  elif is '^(show|open)?( me)?( the| my)? ?(prompts|what i asked|voice commands|learned|what you learned|presence|agents|agent statistics|token usage)$'; then
    # A heading of the dashboard's AI tab.
    local heading
    case "${BASH_REMATCH[4]}" in prompts | "what i asked") heading=prompts ;; presence) heading=presence ;;
    agents | "agent statistics" | "token usage") heading=agents ;; *) heading=voice ;; esac
    shell_call dashboardTab ai
    shell_call aiSection "$heading"
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "AI: $heading"
  elif is '^(scan|sweep)( the| my)? network$|^(who|what) (else )?is on (the|my|this) network$'; then
    # A scan, the way the network allows: quiet off a network of yours.
    shell_call dashboardTab infra
    shell_call infraSection network
    shell_call scanNetwork quiet
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "Scanning the network"
  elif is '^(scan|look|listen)( for)? bluetooth( devices)?$|^(scan|look) for bluetooth devices$|^what bluetooth devices are (near|around|here)$|^which bluetooth devices are (near|around|here)$'; then
    shell_call dashboardTab infra
    shell_call infraSection bluetooth
    shell_call scanBluetooth
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "Listening for Bluetooth devices"
  elif is '^(show|open)?( me)?( the| my)? ?(vpn routes|vpn networks|routes( through| of)?( the)? vpn|what (goes|is) (through|behind) the vpn)$'; then
    # The network picture with the VPN's box open: every network it takes.
    shell_call dashboardTab infra
    shell_call networkDetails vpn
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "Infrastructure: the VPN's routes"
  elif is '^(show|open)?( me)?( the| my)? ?(network|which network( am i (on|in))?|where am i)$'; then
    # A heading of the dashboard's infrastructure tab.
    shell_call dashboardTab infra
    shell_call infraSection network
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "Infrastructure: network"
  elif is '(dashboard|what needs me)$'; then
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "Dashboard"
  elif is '^lock( the)?( screen| computer| desktop)?$'; then
    did "Locking"
    desktop-power lock >/dev/null 2>&1
  elif is '(overview|show( me)?( all)?( the)? (workspaces|windows))$'; then
    shell_call toggleOverview && did "Overview"
  elif is 'launcher$'; then
    shell_call openLauncher && did "Launcher"
  elif is '^clear( all)?( the)? notifications?$'; then
    shell_call clearNotifications && did "Notifications cleared"
  elif is 'notifications?$'; then
    shell_call togglePanel notifications && did "Notifications"
  elif is '(do not disturb|dont disturb|quiet mode)'; then
    did "Do not disturb: $(desktop-shell shell toggleDoNotDisturb 2>/dev/null)"
  elif is '^(be quiet|hush|stop talking|shut up|silence)$'; then
    desktop-say --hush
  elif is '^(voice off|stop speaking|dont speak)$'; then
    desktop-say --mute && did "Voice off"
  elif is '^(voice on|speak again|start speaking)$'; then
    desktop-say --unmute && did "Voice on"
  elif is '^(volume|sound) up$|^louder$'; then
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+ 2>/dev/null && did "Louder"
  elif is '^(volume|sound) down$|^quieter$'; then
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%- 2>/dev/null && did "Quieter"
  elif is '^(mute|unmute)( the)?( sound| volume)?$'; then
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle 2>/dev/null && did "Sound toggled"
  elif is '^(go to|show|jump to|take me to)( the)? (waiting|agent that is waiting|waiting agent|one that is waiting)|^who is waiting|^whos waiting'; then
    go_to_waiting
  elif is '^(start|new|create|begin)( a)?( new)? task( called| named| for)? (.+)$'; then
    # In the repository of the tmux pane you are in, as prefix + T does it: a branch, a
    # worktree, and a tab whose agent works there.
    local name=${BASH_REMATCH[5]} pane where client
    pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
    where=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
    client=$(tmux display-message -p '#{client_name}' 2>/dev/null)
    if [[ -z $pane || -z $where ]]; then
      could_not "There is no tmux window to start a task in"
      return 1
    fi
    (cd "$where" && DESKTOP_WORKTREE_CLIENT="$client" desktop-worktree new --tab "$pane" "$name" >/dev/null 2>&1) &&
      did "Task: ${name// /-}" || could_not "The task could not be started"
  elif is '^(finish|close|end|wrap up)( the| this)? task$'; then
    # Asks before it pushes, in its own popup: this only opens the question.
    local pane client
    pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
    client=$(tmux display-message -p '#{client_name}' 2>/dev/null)
    setsid -f desktop-worktree finish "$pane" "$client" >/dev/null 2>&1
    did "Finishing the task: answer in the popup"
  elif is '^(tech|technology|world)( news)?$|^(show|open)( the)? (tech|technology|world) news$'; then
    local heading=${BASH_REMATCH[1]:-${BASH_REMATCH[5]}}
    [[ $heading == technology ]] && heading=tech
    shell_call dashboardTab news
    shell_call newsSection "$heading"
    hyprctl dispatch "hl.dsp.focus({ workspace = 6 })" >/dev/null 2>&1 && did "News: $heading"
  elif is '^(read|whats|what is)( me)?( the)?( new| latest)?( on| from| in)?( the)? ?(.*)(headlines|news)$|^whats new (on|at|from) (.+)$'; then
    headlines "$(sed -E 's/^(read|whats|what is)( me)?( the)?( new| latest)?( on| from| in| at)?( the)? ?//; s/ ?(headlines|news)$//' <<<"$said")"
  elif is '(cluster|clusters)( status| health)?$|in trouble$'; then
    local report
    report=$(desktop-dash infra --json 2>/dev/null | jq -r '
      if .signed_in == 0 then "You are not signed in to any cluster"
      elif .trouble == 0 then "\(.signed_in) clusters signed in, none in trouble"
      else "In trouble: " + ([.clusters[] | select(.state == "degraded") | "\(.name), \(.nodes - .ready) nodes not ready"] | join("; ")) end')
    show speaking "${report:-No answer from the clusters}" 6
    desktop-say "${report:-No answer from the clusters}."
  elif is '(whats|what is|anything) (behind|out of date|outdated)|new versions?$|^updates$'; then
    local behind
    behind=$(desktop-dash watch --json 2>/dev/null | jq -r '
      [.items[]? | select(.state == "behind") | "\(.name) \(.newest)"] as $b
      | if ($b | length) == 0 then "Everything watched is up to date" else "Newer versions: " + ($b | join(", ")) end')
    show speaking "${behind:-Nothing to report}" 6
    desktop-say "${behind:-Nothing to report}."
  elif is '^(use|change to|switch to)( the)? voice (.+)$|^(use|change to|switch to) (.+)s? voice$'; then
    local wanted=${BASH_REMATCH[3]:-${BASH_REMATCH[5]}} voice
    voice=$(desktop-say --voices --json 2>/dev/null | jq -r --arg w "$wanted" '[.voices[] | select((.label + " " + .name) | ascii_downcase | contains($w))] | first | .name // empty')
    if [[ -n $voice ]]; then
      desktop-say --voice "$voice" >/dev/null 2>&1 &
      did "Voice: $wanted"
    else
      could_not "No voice called “$wanted”"
      return 1
    fi
  elif is '(whats|what is|anything) (waiting|new|up|going on)|^(status|brief|briefing|report)$'; then
    show speaking "$(desktop-brief 2>/dev/null | head -3 | paste -sd'·' | sed 's/·/  ·  /g')" 6
    desktop-brief --say
  elif is 'what time'; then
    did "$(date '+%H:%M')"
    desktop-say "It is $(date '+%-H:%M')."
  elif is '(screenshot|screen shot)$'; then
    did "Screenshot"
    setsid -f desktop-cmd-screenshot >/dev/null 2>&1
  elif is '(ocp[0-9]{3})'; then
    cluster=${BASH_REMATCH[1]}
    # "K9s" is heard as "nines", "canines", "k nines"; anything with nines in it will do.
    if is '(k9s|nines|k 9)'; then
      terminal ocl -k "$cluster" && did "k9s on $cluster"
    elif is 'argo'; then
      terminal ocl -a "$cluster" && did "Argo CD on $cluster"
    else
      terminal ocl "$cluster" && did "Shell on $cluster"
    fi
  elif is '^(open|focus|go to|switch to|show)( the)? (.+)$'; then
    local name=${BASH_REMATCH[3]} address
    address=$(window_named "$name")
    if [[ -n $address ]]; then
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 && did "$name"
    else
      # "Show ..." and "open ..." begin a great many sentences that are not about a window.
      second_try "$heard" "No window called “$name”"
      return
    fi
  else
    second_try "$heard" "Not something I know how to do: “$heard”"
    return
  fi
  remember "$heard"
}

# The key is pressed once. Beside the recording, the same microphone is listened to for
# the one thing that matters -- has somebody spoken, and have they stopped -- and when
# they have, that is the second key press. Pressing the key again still works, for a room
# too noisy to hear a silence in; and nobody having spoken at all cancels, quietly, since
# a key hit by accident should not end in "not something I know how to do".
watch_for_the_end() { # the mark of the recording this belongs to
  local mark=$1
  command -v pw-record >/dev/null 2>&1 || {
    # Without it there is only the clock: after a few seconds the key is taken as pressed.
    (sleep "$MAX_SECONDS"; [[ $(cat "$RUN_DIR/recording" 2>/dev/null) == "$mark" ]] && "$0" toggle) >/dev/null 2>&1 &
    disown 2>/dev/null
    return
  }
  setsid "$0" _watch "$mark" >/dev/null 2>&1 &
  echo $! >"$RUN_DIR/watching"
  disown 2>/dev/null
}

# What that listener is: this script again, in a process group of its own so that it and
# the recorder feeding it can be stopped together.
watching() { # mark
  # Not a pipe from the recorder into the listener: pw-record ignores the signal that
  # says nobody is reading any more, and sat there for ever with the listener long gone
  # -- so the recording was never ended. It is started, listened to, and then stopped.
  local recorder ended
  exec 3< <(exec pw-record --rate 16000 --channels 1 --format s16 --raw - 2>/dev/null)
  recorder=$!
  desktop-voice-endpoint --max "$MAX_SECONDS" <&3
  ended=$?
  kill "$recorder" 2>/dev/null
  exec 3<&-
  # The recording may have ended some other way while this was listening.
  [[ $(cat "$RUN_DIR/recording" 2>/dev/null) == "$1" ]] || return 0
  rm -f "$RUN_DIR/watching"
  if [[ $ended == 0 ]]; then finish_recording; else cancel; fi
}

# The listener beside a recording, stopped: the recording has ended some other way.
stop_watching() {
  local pid
  pid=$(cat "$RUN_DIR/watching" 2>/dev/null) || return 0
  rm -f "$RUN_DIR/watching"
  # Its own process group, so the recorder feeding it goes with it -- unless this is it.
  [[ $pid =~ ^[0-9]+$ && $pid != "$$" && $(ps -o pgid= -p $$ | tr -d " ") != "$pid" ]] && kill -- "-$pid" 2>/dev/null
  return 0
}

cancel() {
  local mark
  mark=$(cat "$RUN_DIR/recording" 2>/dev/null) || return 0
  rm -f "$RUN_DIR/recording"
  stop_watching
  [[ $mark == daemon:* ]] && voxtype record cancel >/dev/null 2>&1
  rm -f "$RUN_DIR/heard.txt" "$RUN_DIR/heard.wav" "$SAY_DIR/now"
}

daemon_running() { [[ $(voxtype status 2>/dev/null) =~ ^(idle|recording|transcribing) ]]; }

recording() {
  [[ -s $RUN_DIR/recording ]] || return 1
  local mark
  mark=$(cat "$RUN_DIR/recording")
  [[ $mark == daemon:* ]] && return 0
  kill -0 "$mark" 2>/dev/null
}

start() {
  mkdir -p "$RUN_DIR" || exit 1
  # Whatever is being said makes way, and would otherwise be what gets recorded.
  desktop-say --hush >/dev/null 2>&1
  rm -f "$RUN_DIR/heard.wav" "$RUN_DIR/heard.txt"
  warm_model

  if daemon_running && voxtype record start --file="$RUN_DIR/heard.txt" >/dev/null 2>&1; then
    local mark="daemon:$(date +%s%N)"
    echo "$mark" >"$RUN_DIR/recording"
    show listening "Listening…"
    watch_for_the_end "$mark"
    return 0
  fi

  command -v pw-record >/dev/null 2>&1 || { could_not "Neither the dictation daemon nor pw-record is there to listen with"; exit 1; }
  # 16 kHz mono is what the recogniser wants, so nothing has to be converted afterwards.
  setsid pw-record --rate 16000 --channels 1 --format s16 "$RUN_DIR/heard.wav" >/dev/null 2>&1 &
  echo $! >"$RUN_DIR/recording"
  show listening "Listening…  (the key again when you have said it)"
  # A key that is never pressed again must not leave the microphone open: after a few
  # seconds it is taken as pressed.
  local pid
  pid=$(cat "$RUN_DIR/recording" 2>/dev/null)
  (
    sleep "$MAX_SECONDS"
    [[ $(cat "$RUN_DIR/recording" 2>/dev/null) == "$pid" ]] && "$0" toggle
  ) >/dev/null 2>&1 &
  disown 2>/dev/null
}

finish_recording() {
  local pid heard
  pid=$(cat "$RUN_DIR/recording" 2>/dev/null)
  rm -f "$RUN_DIR/recording"

  stop_watching

  if [[ $pid == daemon:* ]]; then
    show preparing "…"
    voxtype record stop >/dev/null 2>&1
    # The file appears when the daemon has finished with what it heard.
    for _ in $(seq 200); do [[ -e $RUN_DIR/heard.txt ]] && break; sleep 0.05; done
    heard=$(tr '\n' ' ' <"$RUN_DIR/heard.txt" 2>/dev/null | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
    rm -f "$RUN_DIR/heard.txt"
    interpret "$heard"
    return
  fi

  [[ $pid =~ ^[0-9]+$ ]] && kill -INT "$pid" 2>/dev/null
  # pw-record writes the header as it closes.
  for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
  [[ -s $RUN_DIR/heard.wav ]] || { could_not "Nothing was recorded"; exit 1; }

  show preparing "…"
  heard=$(timeout 60 voxtype transcribe "$RUN_DIR/heard.wav" 2>/dev/null | tail -1 | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  # What was said stays no longer than it takes to understand it.
  rm -f "$RUN_DIR/heard.wav"
  interpret "$heard"
}

understands() {
  cat <<'LIST'
workspace <number>                 go to that workspace
again                              whatever was done last, once more
dashboard                          go to workspace 6
dashboard health / show news       that tab of it: start, domotics, infrastructure, health, finance, watching, news
lock the screen                    lock
overview / show the windows        every workspace at once
launcher                           the application launcher
notifications                      the notification centre; "clear notifications" empties it
do not disturb                     on, or off again
what is waiting / status           the brief, said out loud
what time is it                    the time
louder / quieter / mute            the sound
hush / voice off / voice on        the desktop's own voice
screenshot                         take one
open <name> / go to <name>         the window whose name has those words
shell on ocp204                    a terminal on that cluster (also: k9s on …, argo on …)
tell <project> to <anything>       typed into that project's agent, for you to send
tell it to <anything>              the same, for the agent in the window you are in
go to the waiting agent            the first agent that is waiting for you
start a task called <name>         a branch, a worktree and an agent, in the repository you are in
finish the task                    opens the question that pushes and removes it
show my prompts / voice commands   that heading of the dashboard's AI tab
show my network / where am i       which network this is, on the dashboard
tech news / world news             that heading of the dashboard's News tab
read the headlines / what's new on tweakers     three headlines, read out
cluster status                     which clusters are in trouble, said
what is behind                     what has a newer version out, said
use voice alba                     another voice

Not from here: restart, shut down, log out, suspend. Those are on Super + Escape.
LIST
}

case "${1:-}" in
toggle) if recording; then finish_recording; else start; fi ;;
cancel) cancel ;;
understand) shift; understand "${1:?a sentence}" ;;
mode)
  # desktop-voice mode [local|vpn|cloud|next] [--json]
  case ${2:-} in
  local | vpn | cloud) mkdir -p "$STATE_DIR" && echo "$2" >"$STATE_DIR/mode" && changed ;;
  next) mkdir -p "$STATE_DIR" && case $(mode) in local) echo vpn ;; vpn) echo cloud ;; *) echo local ;; esac >"$STATE_DIR/mode.new" && mv -f "$STATE_DIR/mode.new" "$STATE_DIR/mode" && changed ;;
  esac
  IFS=$'\t' read -r name where < <(model_now)
  note_model "$name" "$where"
  if [[ " $* " == *" --json "* ]]; then
    jq -cn --arg mode "$(mode)" --arg name "$name" --arg where "$where" --argjson key "$([[ -n $(cloud_key) ]] && echo true || echo false)" \
      --argjson vpn "$([[ -n $REMOTE_URL ]] && echo true || echo false)" '{mode: $mode, name: $name, where: $where, cloud_key: $key, vpn_configured: $vpn}'
  else
    echo "$(mode)"
  fi
  ;;
state) state_json ;;
learned)
  if [[ ${2:-} == --json ]]; then state_json | jq '{yours, learned, missed}'
  else state_json | jq -r '
      (if (.yours | length) > 0 then "Yours:", (.yours[] | "  \(.phrase)  ->  \(.command)") else empty end),
      (if (.learned | length) > 0 then "Learned:", (.learned[] | "  \(.phrase)  ->  \(.command)   (\(.by), \(.when))") else "Nothing learned yet." end),
      (if (.missed | length) > 0 then "Not understood:", (.missed[] | "  \(.phrase)   (\(.when))") else empty end)'
  fi ;;
forget) forget "${2:?a phrase}" ;;
teach) teach "${2:-}" "${3:-}" ;;
edit)
  # With a phrase: a line is started for it, to be finished in the editor.
  mkdir -p "$(dirname "$ALIASES")"
  [[ -e $ALIASES ]] || printf '%s\n' "# What a phrase means, for desktop-voice: phrase = command" \
    "# The command is anything from: desktop-voice list" >"$ALIASES"
  [[ -n ${2:-} ]] && ! grep -qF -- "$(normalise "$2") =" "$ALIASES" && printf '%s = \n' "$(normalise "$2")" >>"$ALIASES"
  terminal "${EDITOR:-nvim}" + "$ALIASES" ;;
key)
  # The key for cloud mode, into the keyring. Asked for by secret-tool itself, so it is
  # never an argument and never in the shell's history.
  secret-tool store --label="desktop-voice: Anthropic API key" service desktop-voice account anthropic ;;
model)
  IFS=$'\t' read -r name where < <(model_now)
  note_model "$name" "$where"
  if [[ ${2:-} == --json ]]; then jq -cn --arg name "$name" --arg where "$where" '{name: $name, where: $where}'
  else case $where in
    cloud) echo "$name, at Anthropic -- what you say leaves this machine (sentence only; see sent.log)" ;;
    remote) echo "$name, at ${REMOTE_URL#*://} -- what you say leaves this machine" ;;
    local) echo "$name, on this machine" ;;
    *) echo "no model: the list only" ;;
    esac; fi
  ;;
_watch) shift; watching "${1:?mark}" ;;
run) shift; interpret "$*" ;;
normalise) shift; normalise "$*"; echo ;;
list | "" | -h | --help) understands ;;
*)
  echo "usage: desktop-voice toggle | run <sentence> | list" >&2
  exit 1
  ;;
esac
