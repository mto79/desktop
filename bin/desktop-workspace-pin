#!/usr/bin/env bash

# desktop-workspace-pin: keep the terminal workspace on the widest screen on the desk.
#
#   desktop-workspace-pin          # pin the workspace, live and for the next reload
#   desktop-workspace-pin --print  # print the connector that would be chosen
#
# Workspace 3 holds the terminal, so it wants the widest screen wherever we are -- and
# that is a different connector at every desk (DP-6 at work, DP-8 at home, only the
# laptop panel on the road), which is why this is computed rather than configured.
#
# Physical width in millimetres decides it, not pixels: the 3840x2400 laptop panel
# out-pixels the 3440x1440 ultrawide while being less than half as wide. Screens
# standing on their side are skipped -- a portrait monitor is not a horizontal one --
# and a rotated screen swaps its two EDID dimensions before it is measured.
#
# The rule is written to ~/.config/hypr/workspaces.conf, which hyprland.conf sources, so
# it survives `hyprctl reload`; it is applied live as well, so login needs no reload.

set -euo pipefail

CONF="$HOME/.config/hypr/workspaces.conf"
WORKSPACE="${DESKTOP_WIDE_WORKSPACE:-3}"

# Odd transforms are the 90/270 rotations, which trade a screen's width for its height.
# `// empty` is what keeps a desk with no landscape screen from writing a rule at all.
widest_landscape() {
  hyprctl monitors -j | jq -r '
    map(select(.disabled | not)
        | if (.transform % 2) == 1
          then {name, w: .physicalHeight, h: .physicalWidth}
          else {name, w: .physicalWidth,  h: .physicalHeight}
          end)
    | map(select(.w > .h))
    | max_by(.w).name // empty'
}

case "${1:-}" in
--print)
  widest_landscape
  exit 0
  ;;
"") ;;
*)
  echo "desktop-workspace-pin: unknown option $1" >&2
  exit 2
  ;;
esac

MONITOR="$(widest_landscape)"
if [[ -z "$MONITOR" ]]; then
  echo "desktop-workspace-pin: no landscape screen attached, leaving workspace $WORKSPACE where it is" >&2
  exit 0
fi

{
  echo "# AUTO-GENERATED by desktop-workspace-pin -- edit the script, not this."
  echo "# Generated on $(date)"
  echo
  echo "workspace = $WORKSPACE, monitor:$MONITOR"
} >"$CONF"

hyprctl keyword workspace "$WORKSPACE, monitor:$MONITOR" >/dev/null
