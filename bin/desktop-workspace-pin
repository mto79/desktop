#!/usr/bin/env bash

# desktop-workspace-pin: put each starting workspace on the screen it belongs on.
#
#   desktop-workspace-pin          # pin the workspaces, live and for the next reload
#   desktop-workspace-pin --print  # print "<workspace> <connector>" for each choice
#
# Each workspace names the kinds of screen it wants, most wanted first, and takes the
# first kind the desk has:
#
#   1  laptop            browser and files
#   2  portrait widest   chat
#   3  widest            terminal
#   4  laptop            password manager
#   5  portrait laptop   notes
#
# The connectors behind those kinds differ at every desk (DP-6 at work, DP-7 at home,
# only the panel on the road), which is why this is computed rather than configured.
#
#   laptop    the built-in panel.
#   widest    the widest landscape screen. Physical width in millimetres decides it, not
#             pixels: the 3840x2400 laptop panel out-pixels the 3440x1440 ultrawide
#             while being less than half as wide. On the road it is the panel itself,
#             so "widest" also covers "the ultrawide, or else the laptop".
#   portrait  a screen standing on its side.
#
# A rotated screen swaps its two EDID dimensions before it is measured.
#
# The rules are written to ~/.config/hypr/workspaces.conf, which hyprland.conf sources,
# so they survive `hyprctl reload`. They are applied live as well, and a workspace that
# already exists on the wrong screen is moved: a rule only places a workspace when it is
# created, so after docking one would otherwise stay wherever the undock had put it.

set -euo pipefail

CONF="$HOME/.config/hypr/workspaces.conf"
LAPTOP="${DESKTOP_LAPTOP_MONITOR:-eDP-1}"

PINS=(
  "1 laptop"
  "2 portrait widest"
  "3 widest"
  "4 laptop"
  "5 portrait laptop"
)

# Odd transforms are the 90/270 rotations, which trade a screen's width for its height.
SCREENS="$(hyprctl monitors -j | jq -c '
  map(select(.disabled | not)
      | if (.transform % 2) == 1
        then {name, w: .physicalHeight, h: .physicalWidth}
        else {name, w: .physicalWidth,  h: .physicalHeight}
        end)')"

# `// empty` is what lets a desk without that kind of screen fall to the next kind.
screen_of_kind() {
  case "$1" in
  laptop) jq -r --arg name "$LAPTOP" 'map(select(.name == $name)) | first.name // empty' ;;
  widest) jq -r 'map(select(.w > .h)) | max_by(.w).name // empty' ;;
  portrait) jq -r 'map(select(.h > .w)) | max_by(.h).name // empty' ;;
  esac <<<"$SCREENS"
}

choose() {
  local pin workspace kinds kind monitor
  for pin in "${PINS[@]}"; do
    read -r workspace kinds <<<"$pin"
    for kind in $kinds; do
      monitor="$(screen_of_kind "$kind")"
      if [[ -n "$monitor" ]]; then
        echo "$workspace $monitor"
        continue 2
      fi
    done
    echo "desktop-workspace-pin: no $kinds screen attached, leaving workspace $workspace where it is" >&2
  done
}

case "${1:-}" in
--print)
  choose
  exit 0
  ;;
"") ;;
*)
  echo "desktop-workspace-pin: unknown option $1" >&2
  exit 2
  ;;
esac

CHOSEN="$(choose)"

{
  echo "# AUTO-GENERATED by desktop-workspace-pin -- edit the script, not this."
  echo "# Generated on $(date)"
  echo
  # A here-string of nothing is still one empty line, which would be a broken rule.
  [[ -z "$CHOSEN" ]] || sed 's/^\([0-9]*\) \(.*\)$/workspace = \1, monitor:\2/' <<<"$CHOSEN"
} >"$CONF"

[[ -n "$CHOSEN" ]] || exit 0

WORKSPACES="$(hyprctl workspaces -j)"
FOCUSED="$(hyprctl activeworkspace -j | jq -r '.id')"
moved=0

while read -r workspace monitor; do
  hyprctl keyword workspace "$workspace, monitor:$monitor" >/dev/null

  current="$(jq -r --argjson id "$workspace" 'first(.[] | select(.id == $id) | .monitor) // empty' <<<"$WORKSPACES")"
  if [[ -n "$current" && "$current" != "$monitor" ]]; then
    hyprctl dispatch moveworkspacetomonitor "$workspace" "$monitor" >/dev/null
    moved=1
  fi
done <<<"$CHOSEN"

# Moving a workspace takes the focus along with it; hand it back to where it was.
if ((moved)) && [[ "$FOCUSED" =~ ^[0-9]+$ ]]; then
  hyprctl dispatch workspace "$FOCUSED" >/dev/null
fi
