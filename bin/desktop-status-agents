#!/usr/bin/env bash

# desktop-status-agents: report running AI coding sessions as bar-friendly JSON.
#
# Claude Code, OpenCode and Codex, which is what this desktop actually runs. The count is
# of processes, so two sessions in two tmux windows read as two -- which is the number
# worth knowing when you are wondering what is still working in the background.

set -uo pipefail

names=""
total=0

for tool in claude opencode codex; do
  count=$(pgrep -x -c "$tool" 2>/dev/null || true)
  count=${count:-0}
  ((count > 0)) || continue
  total=$((total + count))
  # Joined here rather than with `paste -sd', '`, which reads its delimiter as a *list*
  # to cycle through: two agents came out as "4 claude,1 opencode" and three as
  # "4 claude,1 opencode 1 codex".
  [[ -n $names ]] && names+=", "
  names+="$count $tool"
done

if ((total == 0)); then
  echo '{"text":"","class":"idle","tooltip":"No agents running"}'
  exit 0
fi

printf '{"text":"%s","class":"busy","tooltip":"%s"}\n' "$total" "$names"
