#!/usr/bin/env bash

# desktop-menu-select: Present a list in the shell and print what was chosen.
#
# The dmenu the desktop menu is built on. Options arrive on stdin, one per line, and
# the chosen one is printed on stdout; nothing chosen means exit 1, so callers can tell
# "cancelled" from "picked the first row". An option is a plain line, or
# glyph<TAB>label<TAB>subtext -- the glyph is shown but never returned.
#
# Falls back to wofi when the shell is not running, which is also what happens while
# the waybar fallback is up.

set -uo pipefail

PROMPT="Select"
PRESELECT=""
WIDTH=0
ROWS=0
WOFI_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --prompt)
    PROMPT="$2"
    shift 2
    ;;
  --select)
    PRESELECT="$2"
    shift 2
    ;;
  --width)
    WIDTH="$2"
    shift 2
    ;;
  --rows)
    ROWS="$2"
    shift 2
    ;;
  --wofi-args)
    read -r -a WOFI_ARGS <<<"$2"
    shift 2
    ;;
  *)
    echo "desktop-menu-select: unknown option $1" >&2
    exit 2
    ;;
  esac
done

OPTIONS=$(cat)

fall_back_to_wofi() {
  local args=("${WOFI_ARGS[@]}")
  if [[ -n "$PRESELECT" ]]; then
    local index
    index=$(grep -nxF "$PRESELECT" <<<"$OPTIONS" | cut -d: -f1)
    [[ -n "$index" ]] && args+=("-a" "$index")
  fi
  printf '%s\n' "$OPTIONS" | wofi --dmenu -p "$PROMPT…" "${args[@]}"
}

command -v quickshell >/dev/null 2>&1 || { fall_back_to_wofi; exit $?; }

WORK=$(mktemp -d) || exit 1
trap 'rm -rf "$WORK"' EXIT

printf '%s\n' "$OPTIONS" >"$WORK/options"

if ! desktop-shell shell select "$WORK/options" "$WORK/result" "$PROMPT" "$PRESELECT" "$WIDTH" "$ROWS" >/dev/null 2>&1; then
  fall_back_to_wofi
  exit $?
fi

# The shell writes the result atomically, so the file appearing means it is complete.
# The timeout is a backstop for a shell that dies mid-selection rather than a real
# limit on how long someone may take to choose.
for _ in $(seq 6000); do
  [[ -f "$WORK/result" ]] && break
  sleep 0.05
done

[[ -f "$WORK/result" ]] || exit 1

# First line is the status, the rest is the selection: an empty file cannot mean
# "cancelled", because writing an empty file is indistinguishable from not writing one.
STATUS=$(head -n 1 "$WORK/result")
[[ "$STATUS" == "1" ]] || exit 1

printf '%s\n' "$(tail -n +2 "$WORK/result")"
