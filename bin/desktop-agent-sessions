#!/usr/bin/env python3

"""The Claude Code sessions on this machine and what each is doing, newest need first.

    desktop-agent-sessions                # a line per session
    desktop-agent-sessions --json         # what the bar and the AI panel read
    desktop-agent-sessions --tmux-status  # "● 1 waiting · 2 working", for tmux's status-right
    desktop-agent-sessions --pick         # choose one in fzf and jump to its pane
    desktop-agent-sessions --next <client> # prefix + N: go to the one needing you most

Read from the records desktop-agent-state writes from Claude Code's hooks, one per session.
Those are only ever removed by a SessionEnd hook, and a session that crashes, is killed, or
dies with its terminal fires none. So a record whose claude process is gone is deleted here
rather than shown: an agent listed as "working" that no longer exists is worse than no list.
The pid is checked against the process name as well as for existence, because pids are
reused and a stale record must not come back to life when an unrelated process takes its pid.

Sessions that sent no pid -- a hook run somewhere the claude process could not be found --
cannot be checked, and are kept for a day before being treated as gone.

A session can also be alive and stuck: "working", and no hook heard from it for minutes.
Every tool call fires one, so that silence is a tool call that has not come back, a turn
interrupted with Esc (which fires no Stop), or a very long think. desktop-agent-state
touches the record on every hook, so its mtime is the last sign of life. The state stays
"working" -- that is what the agent last said -- and "stuck" is added next to it.
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

# Needing you first, then busy, then finished, then untouched.
ORDER = {"waiting": 0, "working": 1, "done": 2, "ready": 3}
UNVERIFIABLE_SECONDS = 24 * 3600
STUCK_SECONDS = int(os.environ.get("DESKTOP_AGENT_STUCK_AFTER") or 300)


def state_dir():
    return Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "desktop" / "agents"


def alive(pid, agent="claude"):
    """Whether the agent that wrote a record is still running: its pid, still that agent.
    opencode and codex report through the same records as claude (desktop-agent-state)."""
    try:
        return Path(f"/proc/{int(pid)}/comm").read_text().strip() == (agent or "claude")
    except (OSError, ValueError, TypeError):
        return False


# Every pane of a server, asked once a run: "%12" -> ("desktop:1.2", "done"). One tmux
# command per agent was what this cost before -- twenty-five each time a sidebar on screen
# refreshed, every two seconds, and most of what the tmux server spent its time on.
PANES = {}


def server_panes(socket):
    if socket in PANES:
        return PANES[socket]
    server = ["-S", socket] if socket else []
    found = {}
    try:
        result = subprocess.run(
            ["tmux", *server, "list-panes", "-a", "-F",
             "#{pane_id}\t#{session_name}:#{window_index}.#{pane_index}\t#{@agent_state}"],
            capture_output=True, text=True, timeout=2,
        )
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                fields = line.split("\t")
                if len(fields) == 3 and fields[0].startswith("%") and fields[1].strip():
                    found[fields[0]] = (fields[1].strip(), fields[2].strip())
    except (OSError, subprocess.SubprocessError):
        pass
    PANES[socket] = found
    return found


def pane_target(pane, socket):
    """session:window.pane for a pane id and the mark on its tab, or None once it has closed.

    Asked of the pane's own server. Pane ids are per server, so asking the default one
    about a pane from another would find that server's own %0 and jump somewhere else.

    The mark is what desktop-agent-state put on the tab and tmux.conf takes off again when
    you arrive there. It is the only record of whether a finished turn has been seen, and
    it comes with the answer already being asked for.
    """
    if not pane:
        return None, ""
    listed = server_panes(socket).get(pane)
    if listed:
        return listed
    # Not in the list: closed, or a server the list could not be had from. Asked on its own.
    server = ["-S", socket] if socket else []
    try:
        result = subprocess.run(
            ["tmux", *server, "display-message", "-p", "-t", pane,
             "#{session_name}:#{window_index}.#{pane_index}\t#{@agent_state}"],
            capture_output=True, text=True, timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return None, ""
    target, _, mark = result.stdout.strip("\n").partition("\t")
    target = target.strip()
    if result.returncode != 0 or not target:
        return None, ""
    return target, mark.strip()


def duration(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def project_of(cwd):
    """What to call the place an agent works in: its directory, or "repository · task".

    A task's worktree is named after its branch, and "fix-runner" alone does not say whose.
    desktop-worktree puts them in <repository>.worktrees/<task>, so the path says both.
    """
    parts = cwd.rstrip("/").split("/")
    for i, part in enumerate(parts[:-1]):
        if part.endswith(".worktrees") and part != ".worktrees":
            return f"{part[:-len('.worktrees')]} · {parts[i + 1]}"
    return parts[-1] or cwd or "?"


def sessions(now=None, targets=True):
    now = time.time() if now is None else now
    home = str(Path.home())
    found = []

    for path in sorted(state_dir().glob("*.json")):
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(record, dict) or record.get("state") not in ORDER:
            continue

        pid = record.get("pid")
        since = record.get("since") if isinstance(record.get("since"), (int, float)) else now
        gone = not alive(pid, record.get("agent")) if pid is not None else now - since > UNVERIFIABLE_SECONDS
        if gone:
            try:
                path.unlink()
            except OSError:
                pass
            continue

        try:
            heard = path.stat().st_mtime
        except OSError:
            heard = since
        quiet = max(0, now - heard)
        cwd = record.get("cwd") or ""
        target, mark = pane_target(record.get("pane"), record.get("socket")) if targets else (None, "")
        found.append({
            "agent": record.get("agent") or "claude",
            "session": record.get("session") or path.stem,
            "state": record["state"],
            "since": since,
            "for": duration(now - since),
            "cwd": cwd,
            "place": ("~" + cwd[len(home):]) if cwd.startswith(home) else cwd,
            "project": project_of(cwd),
            "pane": record.get("pane") or "",
            "socket": record.get("socket") or "",
            "target": target,
            # Finished, and nobody has been to look. "done" alone also covers a session
            # that finished hours ago and was read then.
            "unseen": record["state"] == "done" and mark == "done",
            "stuck": record["state"] == "working" and quiet >= STUCK_SECONDS,
            "quiet": duration(quiet),
            # The prompt the turn began with, cut short by desktop-agent-state.
            "asked": record.get("asked") or "",
        })

    found.sort(key=lambda s: (ORDER[s["state"]], -s["since"]))
    return found


def tmux_option(name, default):
    try:
        value = subprocess.run(["tmux", "show-options", "-gqv", name],
                               capture_output=True, text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        value = ""
    return value or default


def tmux_status():
    """What every tmux status bar shows, whichever session it belongs to.

    The tab marks only cover the windows of the session you are in, so an agent waiting
    in another one was invisible from here. Counted across all of them, and nothing at all
    when nothing is going on -- a status bar that always says "0 waiting" stops being read.
    Waiting in the tabs' own colour; finished turns are left to the tabs, since "done" also
    covers sessions that finished hours ago and were seen.

    Runs every status-interval, for every client, so it asks tmux nothing per session.
    """
    listed = sessions(targets=False)
    waiting = sum(1 for s in listed if s["state"] == "waiting")
    working = sum(1 for s in listed if s["state"] == "working")
    parts = []
    if waiting:
        colour = tmux_option("@agent-waiting-colour", "red")
        parts.append(f"#[fg={colour}]● {waiting} waiting#[default]")
    if working:
        parts.append(f"· {working} working")
    print("  ".join(parts) + ("   " if parts else ""), end="")
    return 0


def pick():
    """The list in fzf, from a tmux popup: Enter jumps to the session's pane.

    The jump moves the client that opened the popup -- to another session if need be,
    which is the point: the window tabs cannot show those. An agent sitting in a column's
    tabs is reached through its column instead, which desktop-agent-tabs works out. A
    session in a different tmux server cannot be switched to from this one, and says how
    to reach it.
    """
    listed = sessions()
    if not listed:
        print("No Claude Code sessions with hooks running.")
        input("\nPress Enter to close. ")
        return 0

    colours = {"waiting": "\033[31m", "working": "\033[33m", "done": "\033[32m", "ready": "\033[2m"}
    lines = []
    for i, s in enumerate(listed):
        where = s["target"] or "closed pane"
        lines.append(f"{i}\t{colours[s['state']]}{s['state']:<8}\033[0m {s['for']:>6}  "
                     f"{s['project']:<24} \033[2m{where}\033[0m")
    try:
        chosen = subprocess.run(
            ["fzf", "--ansi", "--no-sort", "--layout=reverse", "--delimiter=\t", "--with-nth=2",
             "--prompt=agent> ", "--header=Enter jumps to it · Esc closes", "--info=hidden"],
            input="\n".join(lines), capture_output=True, text=True,
        ).stdout.strip()
    except OSError:
        print("fzf is not installed.")
        return 1
    if not chosen:
        return 0

    s = listed[int(chosen.split("\t", 1)[0])]
    if not s["target"]:
        input("That session's pane has closed. Press Enter. ")
        return 0
    own = os.environ.get("TMUX", "").split(",")[0]
    if s["socket"] and own and os.path.realpath(s["socket"]) != os.path.realpath(own):
        input(f"It runs in another tmux server: tmux -S {s['socket']} attach -t {s['target']}\nPress Enter. ")
        return 0
    # Not switch-client: an agent in a column's tabs is reached through the column, whose
    # session is 30 columns wide and already has a client. desktop-agent-tabs knows which
    # it is, and falls back to a plain switch for an agent in an ordinary window.
    subprocess.run(["desktop-agent-tabs", "jump", s["pane"] or s["target"]])
    return 0


def tmux_out(*args):
    try:
        done = subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return ""
    return done.stdout.strip() if done.returncode == 0 else ""


def queue(listed, socket):
    """The sessions that need you, in the order prefix + N visits them.

    Waiting first, longest waiting first: that one has been held up the longest. Then the
    turns that finished and nobody has looked at, newest first, then the stuck ones. Only
    this tmux server's, since a client here cannot be switched to a pane of another.
    """
    here = [s for s in listed if s["target"]
            and (not s["socket"] or not socket
                 or os.path.realpath(s["socket"]) == os.path.realpath(socket))]
    waiting = sorted((s for s in here if s["state"] == "waiting"), key=lambda s: s["since"])
    unseen = sorted((s for s in here if s["unseen"]), key=lambda s: -s["since"])
    stuck = sorted((s for s in here if s["stuck"]), key=lambda s: s["since"])
    return waiting + unseen + stuck


def next_up(client):
    """prefix + N: go to the session needing you most, and on to the next on pressing again.

    The pane it went to last is kept in a server option. Arriving at a waiting agent does
    not stop it waiting -- answering does -- so without that, pressing again would land on
    the same one every time.
    """
    socket = tmux_out("display-message", "-p", "#{socket_path}")
    line = queue(sessions(), socket)
    say = ["display-message"] + (["-c", client] if client else [])
    if not line:
        tmux_out(*say, " No agent needs you")
        return 0
    last = tmux_out("show-options", "-gqv", "@agent_next_last")
    panes = [s["pane"] for s in line]
    at = (panes.index(last) + 1) % len(line) if last in panes else 0
    chosen = line[at]
    tmux_out("set-option", "-gq", "@agent_next_last", chosen["pane"])
    what = "stuck" if chosen["stuck"] and chosen["state"] == "working" else chosen["state"]
    subprocess.run(["desktop-agent-tabs", "jump", chosen["pane"], *([client] if client else [])],
                   capture_output=True)
    tmux_out(*say, f" {at + 1}/{len(line)}  {what} {chosen['for']}  {chosen['project']}")
    return 0


def main():
    if "--tmux-status" in sys.argv[1:]:
        return tmux_status()
    if "--pick" in sys.argv[1:]:
        return pick()
    if "--next" in sys.argv[1:]:
        rest = sys.argv[sys.argv.index("--next") + 1:]
        return next_up(rest[0] if rest else "")
    listed = sessions()
    if "--json" in sys.argv[1:]:
        counts = {state: sum(1 for s in listed if s["state"] == state) for state in ORDER}
        unseen = sum(1 for s in listed if s["unseen"])
        print(json.dumps({"sessions": listed, **counts, "unseen": unseen}))
        return 0

    if not listed:
        print("no Claude Code sessions with hooks running")
        return 0
    for s in listed:
        where = f"  [{s['target']}]" if s["target"] else ""
        print(f"{s['state']:<8} {s['for']:>6}  {s['project']:<24} {s['place']}{where}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
