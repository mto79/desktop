#!/usr/bin/env bash

# desktop-update-secrets: the directories command-line tools keep credentials in, owner-only.
#
#   desktop-update-secrets          # make the missing ones, put back any others can read
#   desktop-update-secrets --check  # say what is wrong, change nothing; exit 1 if anything is
#
# Each tool makes its own directory with whatever umask it ran under, and most never look at
# it again: kubectl wrote ~/.kube 0755 with a config 0644 holding cluster tokens, and the aws
# cli's ~/.aws/cli/cache, where SSO sessions land, was 0755 too. So every account on the
# machine could read them. The directory is what is fixed -- 0700 shuts everything under it
# -- and for the few files that are known to be credentials, the file as well.
#
# Run by desktop-update every time, because the check is a stat and the way these drift (an
# unpacked backup, a `cp` without -p, a tool recreating its directory) does not announce
# itself. Run by a clean install after tofu and kubectl, so they start out right.
#
# Only modes are changed. Nothing is read, and nothing that is not there is made, except the
# directories a tool that is installed expects to find (~/.config/tofu for OpenTofu's .env
# files, which nothing else creates).

set -uo pipefail

home=${DESKTOP_SECRETS_HOME:-$HOME}
config=${XDG_CONFIG_HOME:-$home/.config}
[[ -n ${DESKTOP_SECRETS_HOME:-} ]] && config=$home/.config

# path, mode, and the command whose presence means it should exist ("-" for: only if it does).
entries=(
  "$config/tofu 700 tofu"
  "$home/.kube 700 kubectl"
  "$home/.kube/config 600 -"
  "$home/.aws 700 -"
  "$home/.aws/credentials 600 -"
  "$config/gh 700 -"
  "$config/helm 700 -"
)

check=0
[[ ${1:-} == --check ]] && check=1
wrong=0

echo -e "\e[32m\nCheck credential directories\e[0m"

for entry in "${entries[@]}"; do
  read -r path mode needs <<<"$entry"
  shown=${path/#$home/\~}
  if [[ ! -e $path ]]; then
    [[ $needs != - ]] && command -v "$needs" >/dev/null 2>&1 || continue
    if ((check)); then
      echo "$shown: missing"
      wrong=1
    else
      install -d -m "0$mode" "$path" && echo "$shown: made, owner-only"
    fi
    continue
  fi
  have=$(stat -L -c %a "$path")
  [[ $have == "$mode" ]] && continue
  # Tighter than asked for is fine: 0400 on a key is not something to loosen.
  (((8#$have & ~8#$mode) == 0)) && continue
  if ((check)); then
    echo "$shown: mode $have, others can read it"
    wrong=1
  else
    chmod "0$mode" "$path" && echo "$shown: was mode $have, now $mode"
  fi
done

if ((check)); then
  ((wrong)) || echo "all owner-only"
  exit "$wrong"
fi
exit 0
