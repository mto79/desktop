#!/usr/bin/env python3
"""Keep what is private out of a repository that anyone can read.

    desktop-privacy-check             # what is staged: the lines about to be committed
    desktop-privacy-check --all       # every tracked file, as it is now
    desktop-privacy-check --history   # every line any commit ever added, on every branch

Exits 1 when it finds something, and says where. .githooks/pre-commit runs the first form,
so a finding stops the commit.

This repository is public, and it is the configuration of one real machine, so the two
meet constantly: a comment showing a command's output shows the home network, a default
written for this machine names its NAS, a test fixture is pasted from the real thing. A
line deleted a day later is still in the history, for good.

What it looks for:

    secret        private keys, and tokens in the shapes the forges and clouds issue them
    home-path     /home/<a real login name>/ -- which is also a script that only works here
    mac-address   a network card or access point; an access point's can be looked up on a map
    email         an address that is not plainly a placeholder
    filename      key files, password stores, .env, compiled Python
    denied        anything matching the deny list

The deny list is what makes it yours: ~/.config/desktop/privacy-deny, one extended regular
expression a line, matched whatever the case. It holds the words that are private to you
-- an employer's domain, a hostname, a street -- and so it is never in the repository,
which would publish the list of things not to publish. It is also matched against the
name and address a commit is about to be made under.

A finding that is fine is let through in one of two ways: `privacy: allow` anywhere on the
line itself, or a pattern in .githooks/privacy-allow for what cannot carry a comment or
is not ours to edit.
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

MARKER = "privacy: allow"

# Login names that are nobody's: what the tests and the examples use.
NOBODY = {"u", "me", "you", "user", "username", "someone", "somebody", "name", "example"}

# The documentation range of RFC 7042, and the ones people type when they mean "a MAC".
PLACEHOLDER_MACS = re.compile(
    r"^(00:00:5e:00:53:..|00:00:00:00:00:00|ff:ff:ff:ff:ff:ff"
    r"|aa:bb:cc:dd:ee:ff|00:11:22:33:44:55|01:23:45:67:89:ab|11:22:33:44:55:66)$"
)

# An address that says of itself that it is not one, or is a unit or a file and not an
# address at all: getty@tty1.service, icon@2x.png.
PLACEHOLDER_EMAIL = re.compile(
    r"(@example\.(com|org|net|nl)$|\.example$|^(git|noreply|no-reply)@|@users\.noreply\.github\.com$"
    r"|^your|\.(service|timer|socket|target|mount|path|slice|png|svg|jpg|conf|sh|lua|qml|json)$)"
)

# What is written where a secret would go, by someone showing the shape of one.
PLACEHOLDER_SECRET = re.compile(r"(x{4,}|\.{3}|example|your|changeme|placeholder|dummy|<[^>]+>)", re.I)

SECRETS = [
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bgh[pousr]_[A-Za-z0-9]{36,}",
    r"\bgithub_pat_[A-Za-z0-9_]{40,}",
    r"\bglpat-[A-Za-z0-9_-]{20,}",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"\bxox[abprs]-[A-Za-z0-9-]{10,}",
    r"\bsk-[A-Za-z0-9_-]{32,}",
    r"\bdop_v1_[a-f0-9]{64}\b",
    r"\bAIza[0-9A-Za-z_-]{35}\b",
    r"\beyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}",
    # A Proxmox API token: user@realm!name=uuid. The uuid is the secret.
    r"[\w.-]+@[\w.-]+![\w.-]+=[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}",
    # password = "...", api_key: ..., TOKEN=... with something long, literal and mixed
    # after it. Letters alone are a name -- SECRET_HINT="x-kde-passwordManagerHint" -- and
    # what is generated has digits in it.
    r"(?i)\b[\w-]*(?:passw(?:or)?d|secret|token|api[_-]?key)[\w-]*[\"']?\s*[:=]\s*[\"']?"
    r"(?=[A-Za-z0-9+/_-]*[0-9])(?=[A-Za-z0-9+/_-]*[A-Za-z])[A-Za-z0-9+/_-]{20,}",
]

HOME = re.compile(r"/home/([a-z_][a-z0-9_-]*)")
# Not the middle of something longer in the same notation, which an IPv6 address is.
MAC = re.compile(
    r"(?<![0-9A-Fa-f])(?<![0-9A-Fa-f]:)(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}(?![0-9A-Fa-f])(?!:[0-9A-Fa-f])"
)
EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")

FILENAME = re.compile(
    r"(^|/)(id_(rsa|dsa|ecdsa|ed25519)|[^/]*\.(pem|key|p12|pfx|kdbx|ovpn|pyc)|\.env(\.[^/]*)?"
    r"|\.netrc|[^/]*restic-password[^/]*|[^/]*\.vault[^/]*)$"
)


def git(*args, check=True):
    done = subprocess.run(("git",) + args, capture_output=True)
    if check and done.returncode != 0:
        sys.stderr.write(done.stderr.decode(errors="replace"))
        sys.exit(2)
    return done.stdout.decode(errors="replace")


def patterns(path):
    """One expression a line; blank lines and # comments are not expressions."""
    found = []
    try:
        lines = Path(path).read_text().splitlines()
    except OSError:
        return found
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            found.append(re.compile(line, re.I))
        except re.error as error:
            sys.stderr.write(f"desktop-privacy-check: {path}: {line!r} is not a pattern: {error}\n")
            sys.exit(2)
    return found


def shown(kind, text):
    """A finding is printed into terminals, logs and agent transcripts. A secret is not
    repeated there whole."""
    text = text.strip()
    if kind == "secret" and len(text) > 16:
        return text[:12] + "..."
    return text if len(text) <= 80 else text[:77] + "..."


class Check:
    def __init__(self, deny, allow):
        self.deny = deny
        self.allow = allow
        self.findings = []

    def allowed(self, text):
        return any(pattern.search(text) for pattern in self.allow)

    def add(self, where, kind, text):
        if self.allowed(text):
            return
        finding = (where, kind, shown(kind, text))
        if finding not in self.findings:
            self.findings.append(finding)

    def line(self, where, text):
        if MARKER in text:
            return
        for pattern in SECRETS:
            for match in re.finditer(pattern, text):
                if not PLACEHOLDER_SECRET.search(match.group(0)):
                    self.add(where, "secret", match.group(0))
        for match in HOME.finditer(text):
            if match.group(1) not in NOBODY:
                self.add(where, "home-path", match.group(0))
        for match in MAC.finditer(text):
            if not PLACEHOLDER_MACS.match(match.group(0).lower()):
                self.add(where, "mac-address", match.group(0))
        for match in EMAIL.finditer(text):
            if not PLACEHOLDER_EMAIL.search(match.group(0).lower()):
                self.add(where, "email", match.group(0))
        for pattern in self.deny:
            for match in pattern.finditer(text):
                self.add(where, "denied", match.group(0))

    def name(self, where, path):
        if FILENAME.search(path):
            self.add(where, "filename", path)
        for pattern in self.deny:
            match = pattern.search(path)
            if match:
                self.add(where, "denied", match.group(0))

    def identity(self, where, ident):
        for pattern in self.deny:
            match = pattern.search(ident)
            if match:
                self.add(where, "denied", f"committing as {ident}")


HUNK = re.compile(r"^@@ -\d+(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def added(diff, check, commit=""):
    """Walk a -U0 diff and hand over each added line with where it will be. Hunks are
    counted through rather than recognised by their first character, because a file's own
    lines can begin with '+++ b/' or '@@' as easily as a diff's can."""
    path, named, number, minus, plus = None, False, 0, 0, 0
    seen = set()
    for raw in diff.split("\n"):
        if minus or plus:
            if raw.startswith("\\"):
                continue
            if raw.startswith("-") and minus:
                minus -= 1
            elif raw.startswith("+") and plus:
                plus -= 1
                if path:
                    check.line(f"{commit}{path}:{number}", raw[1:])
                number += 1
            continue
        if raw.startswith("\x01"):
            commit, _, ident = raw[1:].partition("\t")
            check.identity(commit, ident)
            commit += " "
            path = None
        elif raw.startswith("diff --git a/"):
            # The name is taken from here, not from the +++ line: a binary file has none,
            # and a key file is as likely to be binary as not. Renames are off, so both
            # halves are the same path.
            path = raw[len("diff --git a/") :].partition(" b/")[0]
            named = False
        elif raw.startswith("deleted file mode"):
            path = None
        elif path and not named and not raw.startswith(("old mode", "new mode")):
            named = True
            if (commit, path) not in seen:
                seen.add((commit, path))
                check.name(f"{commit}{path}", path)
        hunk = HUNK.match(raw) if path else None
        if hunk:
            minus = int(hunk.group(1) or 1)
            number = int(hunk.group(2))
            plus = int(hunk.group(3) or 1)


# Whatever the user's own git configuration says about how a diff should look.
DIFF = ("--no-ext-diff", "--no-color", "--no-renames", "-U0", "--src-prefix=a/", "--dst-prefix=b/")


def staged(check):
    ident = git("var", "GIT_AUTHOR_IDENT", check=False).rsplit(" ", 2)[0]
    if ident:
        check.identity("author", ident)
    added(git("diff", "--cached", "--diff-filter=AM", *DIFF), check)


def history(check):
    added(git("log", "--all", "-p", "--format=%x01%h%x09%an <%ae>", *DIFF), check)


def tree(check):
    top = Path(git("rev-parse", "--show-toplevel").strip())
    for path in git("ls-files", "-z").split("\0"):
        if not path:
            continue
        check.name(path, path)
        try:
            data = (top / path).read_bytes()
        except OSError:
            continue
        if b"\0" in data[:8192]:
            continue
        for number, text in enumerate(data.decode(errors="replace").split("\n"), 1):
            check.line(f"{path}:{number}", text)


def main():
    parser = argparse.ArgumentParser(description="Keep what is private out of a public repository.")
    scope = parser.add_mutually_exclusive_group()
    scope.add_argument("--all", action="store_true", help="every tracked file, as it is now")
    scope.add_argument("--history", action="store_true", help="every line any commit ever added")
    args = parser.parse_args()

    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    deny = os.environ.get("DESKTOP_PRIVACY_DENY") or config / "desktop" / "privacy-deny"
    top = git("rev-parse", "--show-toplevel").strip()
    check = Check(patterns(deny), patterns(Path(top) / ".githooks" / "privacy-allow"))

    if args.all:
        tree(check)
    elif args.history:
        history(check)
    else:
        staged(check)

    if not check.findings:
        return 0

    width = max(len(kind) for _, kind, _ in check.findings)
    for where, kind, text in check.findings:
        print(f"{kind:<{width}}  {where}  {text}", file=sys.stderr)
    print(f"\n{len(check.findings)} thing(s) that look private. See docs/privacy.md.", file=sys.stderr)
    if not (args.all or args.history):
        print(
            f"Nothing was committed. If one is fine, put '{MARKER}' on its line or a pattern\n"
            "in .githooks/privacy-allow; git commit --no-verify skips the check altogether.",
            file=sys.stderr,
        )
    return 1


if __name__ == "__main__":
    sys.exit(main())
