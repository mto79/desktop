#!/usr/bin/env bash

# desktop-cluster (also: ocl): the Kubernetes clusters this desktop knows, whatever runs them.
#
#   ocl                     pick a cluster, then a shell on it
#   ocl NAME                a shell on NAME, signing in first when it is needed
#   ocl -k NAME             k9s on NAME
#   ocl -a NAME             Argo CD on NAME (argo9s)
#   ocl -c NAME             NAME's web console, in the browser
#   ocl -t NAME [NODE...]   the Talos dashboard (talos clusters only)
#   ocl -x NAME CMD...      one command against NAME, then back
#   ocl -e NAME             the environment for NAME, for this shell:  ocl -e NAME | source
#   ocl session [NAME]      a tmux session on NAME, a shell and k9s; prefix + K picks one
#   ocl login NAME          sign in again, or fetch the kubeconfig again
#   ocl logout NAME         forget NAME's credentials, and close its tmux session
#   ocl list                every cluster: name, kind, where it is
#   ocl status [NAME...]    every cluster asked, all at once: signed in, nodes, version
#   ocl status --json NAME  the same for one, as the dashboard reads it
#   ocl names               the names, one per line
#   ocl edit                open the clusters file
#
# ocl began as a script for OpenShift alone, with its list of clusters written into the
# script and every login landing in the one ~/.kube/config. That shared file is what this
# replaces: a cluster has a kubeconfig of its own, under ~/.local/state/desktop/clusters,
# and a shell, k9s or Argo CD on it is handed that file and nothing else. Two terminals on
# two clusters cannot pull each other's context away, a `kubectl delete` cannot land on the
# cluster another window switched to, and signing out of one is deleting one file.
#
# The clusters are listed in ~/.config/desktop/clusters.conf, a line each:
#
#   # name    kind       how to reach it, and anything else
#   ocp202    openshift  server=https://api.ocp202.example:6443
#   lab       rke2       ssh=admin@lab-cp1.example server=https://lab-cp1.example:6443
#   edge      talos      talosconfig=~/.talos/edge.yaml nodes=192.0.2.11
#   kind      kubernetes kubeconfig=~/.kube/clusters/kind.yaml
#
# How each kind is signed in to:
#   openshift   oc login at server=. login=password (the default) asks for a user and a
#               password, login=web goes through the browser, login=token asks for a token.
#   rke2        the kubeconfig RKE2 writes on a server node: fetched over ssh= (it needs
#               sudo there), or copied from kubeconfig=. server= replaces the 127.0.0.1 in it.
#   talos       talosctl kubeconfig, with talosconfig= and nodes= (or the talosconfig's own).
#   kubernetes  a kubeconfig file you already have, copied from kubeconfig=.
#
# And for any kind: namespace= to start in, console= for -c, argocd= for the namespace
# Argo CD runs in (openshift-gitops on OpenShift, argocd elsewhere), insecure=true to skip
# TLS verification, ca= for a CA file to verify it with.
#
# Never written into the repository: the file names hosts, and the repository is public.

set -uo pipefail

CONF="${DESKTOP_CLUSTERS:-${XDG_CONFIG_HOME:-$HOME/.config}/desktop/clusters.conf}"
STORE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/clusters"
ME=${0##*/}
RESERVED=" list status names login logout edit help session "

die() {
  echo "$ME: $*" >&2
  # Started from a key or the voice there is no terminal to read this in, or one about to close.
  [[ -t 2 || ${QUIET:-} ]] || notify-send -u critical "Cluster" "$*" 2>/dev/null || true
  exit 1
}

usage() { sed -n '3,20s/^# \{0,1\}//p' "$0"; }

# ------------------------------------------------------------------------------ the file

# Every cluster, "name<TAB>kind<TAB>key=value ...", comments and blank lines gone.
entries() {
  [[ -r $CONF ]] || return 0
  awk '{ sub(/#.*/, "") } NF >= 2 { name = $1; kind = $2; $1 = ""; $2 = ""; sub(/^ +/, ""); print name "\t" kind "\t" $0 }' "$CONF"
}

names() { entries | cut -f1; }

# load NAME: sets KIND and the cluster's settings (opt_server, opt_login, ...), and FILE,
# the cluster's own kubeconfig.
load() {
  local line kv key value
  line=$(entries | awk -F'\t' -v n="$1" '$1 == n { print; exit }')
  [[ -n $line ]] || die "no cluster called $1 in $CONF (there are: $(names | paste -sd' '))"
  NAME=$1
  KIND=$(cut -f2 <<<"$line")
  opt_server="" opt_login="" opt_kubeconfig="" opt_talosconfig="" opt_nodes="" opt_ssh=""
  opt_namespace="" opt_console="" opt_argocd="" opt_insecure="" opt_ca=""
  for kv in $(cut -f3 <<<"$line"); do
    key=${kv%%=*} value=${kv#*=}
    [[ $kv == *=* ]] || die "$NAME: '$kv' is not key=value"
    value=${value/#\~/$HOME}
    case "$key" in
    server | login | kubeconfig | talosconfig | nodes | ssh | namespace | console | argocd | insecure | ca)
      printf -v "opt_$key" '%s' "$value" ;;
    *) die "$NAME: unknown setting '$key'" ;;
    esac
  done
  case "$KIND" in
  openshift) [[ -n $opt_server ]] || die "$NAME: an openshift cluster needs server=" ;;
  rke2) [[ -n $opt_ssh || -n $opt_kubeconfig ]] || die "$NAME: an rke2 cluster needs ssh= or kubeconfig=" ;;
  talos) [[ -n $opt_talosconfig || -n ${TALOSCONFIG:-} || -r $HOME/.talos/config ]] || die "$NAME: a talos cluster needs talosconfig=" ;;
  kubernetes) [[ -n $opt_kubeconfig ]] || die "$NAME: a kubernetes cluster needs kubeconfig=" ;;
  *) die "$NAME: unknown kind '$KIND' (openshift, rke2, talos or kubernetes)" ;;
  esac
  FILE="$STORE/$NAME.kubeconfig"
}

# ------------------------------------------------------------------------------ signing in

kc() { kubectl --kubeconfig "$FILE" "$@"; }

# Whether the kubeconfig is there and the cluster takes it: "ok", "signed-out" or "unreachable".
reach() {
  local err
  [[ -s $FILE ]] || { echo signed-out; return; }
  if [[ $KIND == openshift ]] && command -v oc >/dev/null 2>&1; then
    err=$(oc --kubeconfig "$FILE" --request-timeout=5s whoami 2>&1 >/dev/null) && { echo ok; return; }
  else
    # /apis needs an authenticated user; /version does not, so it would say nothing.
    err=$(kc --request-timeout=5s get --raw /apis 2>&1 >/dev/null) && { echo ok; return; }
  fi
  if grep -qiE 'unauthori[sz]ed|forbidden|must be logged in|401|credentials|expired|certificate.*(signed by unknown|has expired)' <<<"$err"; then
    echo signed-out
  else
    echo unreachable
  fi
}

talos_args() {
  local args=()
  [[ -n $opt_talosconfig ]] && args+=(--talosconfig "$opt_talosconfig")
  [[ -n $opt_nodes ]] && args+=(--nodes "$opt_nodes")
  ((${#args[@]})) && printf '%s\n' "${args[@]}"
  return 0
}

# oc login --web opens the sign-in page with xdg-open, as a tab in whatever browser window
# was last used, and leaves it there -- on the callback page -- when it is done. On the
# desktop it is given a web-app window of its own instead, through an xdg-open found first
# on PATH, and that window is closed once oc returns: signed in or not, nothing is left to
# close by hand. Off the desktop (ssh, no Hyprland) oc opens what it always did.
web_window() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v desktop-launch-webapp >/dev/null 2>&1 || return 0
  mkdir -p "$1"
  cat >"$1/xdg-open" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$1" >'$1/url'
desktop-launch-webapp "\$1" >/dev/null 2>&1
STUB
  chmod +x "$1/xdg-open"
}

# A Chromium web-app window is classed after the page it opened, as
# brave-HOST__PATH-Default, so the sign-in window is told from every other by its host.
web_windows() { # dir -> the sign-in window's addresses, once oc has opened one
  local url host
  url=$(cat "$1/url" 2>/dev/null) || return 0
  host=${url#*://} host=${host%%[/?#]*} host=${host%%:*}
  [[ -n $host ]] || return 0
  hyprctl clients -j 2>/dev/null |
    jq -r --arg h "-${host}__" '.[] | select(.initialClass | contains($h)) | .address'
}

close_web_window() {
  local addr
  web_windows "$1" | while read -r addr; do
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
  done
}

# oc login --web waits for the browser's callback, and without one it waits for ever: the
# sign-in window closed unfinished left oc, and the tmux window the sidebar had opened for
# it, there for good -- one more each time the cluster was chosen again. So oc is watched
# while it waits: the window seen and then gone is a sign-in given up, and so is five
# minutes without one.
WEB_PATIENCE=${DESKTOP_CLUSTER_WEB_PATIENCE:-300}
web_login() { # dir oc-args...
  local dir=$1 pid seen=false start=$SECONDS
  shift
  PATH="$dir:$PATH" oc login "$@" &
  pid=$!
  # A job started with & ignores Ctrl-C in a script, so it is passed on by hand; exit runs
  # login's EXIT trap, which takes the scratch files away.
  # shellcheck disable=SC2064
  trap "kill $pid 2>/dev/null; close_web_window '$dir'; exit 130" INT TERM HUP
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    if [[ -n $(web_windows "$dir") ]]; then
      seen=true
    elif $seen; then
      kill -0 "$pid" 2>/dev/null || break
      echo "The sign-in window was closed before signing in." >&2
      kill "$pid" 2>/dev/null
      break
    fi
    if ((SECONDS - start >= WEB_PATIENCE)); then
      echo "No sign-in after $((WEB_PATIENCE / 60)) minutes; giving up." >&2
      kill "$pid" 2>/dev/null
      break
    fi
  done
  wait "$pid"
  local status=$?
  trap - INT TERM HUP
  return "$status"
}

# The new kubeconfig is written beside the old and moved over it only once it is whole:
# a sign-in that fails, or is cancelled at its password prompt, leaves the old one.
login() {
  local tmp raw server
  mkdir -p "$STORE" && chmod 700 "$STORE"
  tmp=$(mktemp "$STORE/.$NAME.XXXXXX")
  chmod 600 "$tmp"
  # EXIT, not RETURN: die leaves by exit, and a RETURN trap does not see that.
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp' '$tmp.raw' '$tmp.web'" EXIT
  case "$KIND" in
  openshift)
    command -v oc >/dev/null 2>&1 || die "oc is not installed (desktop-update-oc)"
    local args=(--kubeconfig "$tmp" --server "$opt_server")
    [[ $opt_insecure == true ]] && args+=(--insecure-skip-tls-verify=true)
    [[ -n $opt_ca ]] && args+=(--certificate-authority "$opt_ca")
    case "${opt_login:-password}" in
    password) echo "Signing in to $NAME ($opt_server)" ;;
    web)
      args+=(--web)
      web_window "$tmp.web"
      ;;
    token)
      local token
      read -rsp "Token for $NAME (from the console, Copy login command): " token && echo
      [[ -n $token ]] || die "no token given"
      args+=(--token "$token")
      ;;
    *) die "$NAME: login= is password, web or token" ;;
    esac
    local ok=true
    if [[ -x $tmp.web/xdg-open ]]; then
      web_login "$tmp.web" "${args[@]}" || ok=false
    else
      oc login "${args[@]}" || ok=false
    fi
    close_web_window "$tmp.web"
    $ok || die "signing in to $NAME failed"
    ;;
  rke2 | kubernetes)
    if [[ -n $opt_ssh ]]; then
      echo "Fetching $NAME's kubeconfig from $opt_ssh"
      ssh "$opt_ssh" 'sudo cat /etc/rancher/rke2/rke2.yaml' >"$tmp.raw" || die "could not read /etc/rancher/rke2/rke2.yaml on $opt_ssh"
      # RKE2 writes it for use on the node itself; from here the API is the node's own name.
      server=${opt_server:-https://${opt_ssh#*@}:6443}
    else
      [[ -r $opt_kubeconfig ]] || die "$NAME: cannot read $opt_kubeconfig"
      cp "$opt_kubeconfig" "$tmp.raw"
      server=$opt_server
    fi
    KUBECONFIG="$tmp.raw" kubectl config view --raw --flatten --minify >"$tmp" || die "$NAME: that is not a kubeconfig"
    if [[ -n $server ]]; then
      raw=$(KUBECONFIG="$tmp" kubectl config view --minify -o jsonpath='{.clusters[0].name}')
      KUBECONFIG="$tmp" kubectl config set-cluster "$raw" --server "$server" >/dev/null
    fi
    ;;
  talos)
    command -v talosctl >/dev/null 2>&1 || die "talosctl is not installed (desktop-update-releases talosctl)"
    local targs
    mapfile -t targs < <(talos_args)
    # --force: the file mktemp made is empty and talosctl would otherwise not write over it.
    talosctl "${targs[@]}" kubeconfig --force --merge=false "$tmp" || die "talosctl could not get $NAME's kubeconfig"
    ;;
  esac
  [[ $opt_insecure == true && $KIND != openshift ]] &&
    KUBECONFIG="$tmp" kubectl config set-cluster "$(KUBECONFIG="$tmp" kubectl config view --minify -o jsonpath='{.clusters[0].name}')" \
      --insecure-skip-tls-verify=true >/dev/null
  # Named after the cluster, whatever the tool called it: it is what the prompt shows, and
  # "default@default" for every RKE2 cluster says nothing.
  KUBECONFIG="$tmp" kubectl config rename-context "$(KUBECONFIG="$tmp" kubectl config current-context)" "$NAME" >/dev/null 2>&1 || true
  [[ -n $opt_namespace ]] && KUBECONFIG="$tmp" kubectl config set-context "$NAME" --namespace "$opt_namespace" >/dev/null
  # Again after the tools have had it: oc and kubectl write a new file rather than the one
  # they were given, and it holds a token.
  chmod 600 "$tmp" && mv -f "$tmp" "$FILE"
  rm -f "$tmp.raw"
  status_stale
  echo "Signed in to $NAME"
}

ensure() {
  case "$(reach)" in
  ok) ;;
  signed-out) login ;;
  unreachable)
    [[ -s $FILE ]] || login
    echo "$ME: $NAME does not answer; going on with what is there" >&2
    ;;
  esac
}

environment() {
  export KUBECONFIG=$FILE DESKTOP_CLUSTER=$NAME DESKTOP_CLUSTER_KIND=$KIND
  if [[ $KIND == talos ]]; then
    [[ -n $opt_talosconfig ]] && export TALOSCONFIG=$opt_talosconfig
  fi
  return 0
}

# Columns without column(1): util-linux's, which is not on every machine this runs from.
table() { awk -F'\t' '{ for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } n[NR] = NF }
  END { for (r = 1; r <= NR; r++) { line = ""; for (i = 1; i <= n[r]; i++) line = line sprintf(i < n[r] ? "%-" w[i] + 2 "s" : "%s", cell[r, i]); sub(/ +$/, "", line); print line } }'; }

# The dashboard keeps what `status` said for two minutes and the tmux sidebar for one; a
# sign-in or out here is a change they should show the next time they look, not after that.
# The dashboard's is deleted. The sidebar's is shared by every column and drawn from while a
# new one is asked for, so it is aged instead -- the next draw asks again -- and a sign-out
# is written into it at once, rather than the cluster showing healthy until the answer.
status_stale() { # [signed-out]
  local side="${XDG_RUNTIME_DIR:-/tmp}/desktop/clusters.json"
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/desktop/dashboard/infra.json"
  [[ -f $side ]] || return 0
  if [[ ${1:-} == signed-out ]]; then
    jq -c --arg n "$NAME" 'map(if .name == $n then .state = "signed-out" | .nodes = 0 | .ready = 0 else . end)' \
      "$side" >"$side.$$" 2>/dev/null && mv -f "$side.$$" "$side" || rm -f "$side.$$"
  fi
  touch -d @0 "$side" 2>/dev/null
  return 0
}

# ------------------------------------------------------------------------------ the agent

# A cluster's session has a coding agent beside its shell, as a repository's has -- one
# that may read and write files but never reach the cluster. It works in a folder of the
# cluster's own, for notes and manifests, and that folder carries settings for each of the
# three agents the column can hold that keep it off the cluster (fence_* below; the table
# in docs/clusters.md). The session's own tmux environment never had the cluster's
# KUBECONFIG -- the column's agents run in sessions of their own -- so this is the second
# fence, not the first.
AGENT_HOME=${DESKTOP_CLUSTER_AGENT_HOME:-$HOME/clusters}
AGENT_DENY='["Bash(oc:*)", "Bash(kubectl:*)", "Bash(kubecolor:*)", "Bash(ocl:*)",
  "Bash(desktop-cluster:*)", "Bash(k9s:*)", "Bash(argo9s:*)", "Bash(talosctl:*)",
  "Bash(kubie:*)", "Bash(kubens:*)", "Bash(kubectx:*)", "Bash(argocd:*)",
  "Read(~/.local/state/desktop/clusters/**)", "Read(~/.kube/**)", "Read(~/.talos/**)",
  "Read(~/.config/desktop/clusters.conf)"]'

# The hosts that are the clusters: every server=, console= and ssh= in clusters.conf, by
# name. A sandbox that cannot reach these cannot reach a cluster, whatever it has read.
cluster_hosts() {
  entries | cut -f3 | tr ' ' '\n' | sed -n 's/^\(server\|console\|ssh\)=//p' |
    sed 's#^[a-z]*://##; s#^[^@]*@##; s#[:/].*##' | sort -u | grep -v '^$' || true
}

# Settings that name the organisation stay out of this public repository, in a file of
# their own beside clusters.conf: which opencode providers a cluster's folder may use
# (opencode-providers=, by the id in opencode's own config). None named, none allowed.
AGENT_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/desktop/cluster-agents.conf
agent_setting() { sed -n "s/^$1=//p" "$AGENT_CONF" 2>/dev/null | tail -1; }

# Each file merged with what is there, so settings of the folder's own are kept: the fence
# is added to them, and written again every time the session is made.
merge_json() { # file jq-filter [jq args...]
  local file=$1 filter=$2 current='{}'
  shift 2
  mkdir -p "${file%/*}"
  [[ -s $file ]] && current=$(cat "$file")
  jq "$@" "$filter" <<<"$current" >"$file.$$" && mv -f "$file.$$" "$file" || { rm -f "$file.$$"; return 1; }
}

# claude: the deny rules, no kubeconfig, no bypass mode, and its sandbox -- Bash in
# bubblewrap, with the kubeconfigs unreadable and no way out to a cluster's hosts. On, or
# claude does not start (failIfUnavailable), and with no unsandboxed retry.
fence_claude() { # dir
  local hosts
  hosts=$(cluster_hosts | jq -R . | jq -sc .)
  merge_json "$1/.claude/settings.json" '
    .permissions.deny = (((.permissions.deny // []) + $deny) | unique)
    | .permissions.disableBypassPermissionsMode = "disable"
    | .env.KUBECONFIG = "/dev/null"
    | .sandbox.enabled = true
    | .sandbox.failIfUnavailable = true
    | .sandbox.allowUnsandboxedCommands = false
    | .sandbox.filesystem.denyRead = (((.sandbox.filesystem.denyRead // []) + $paths) | unique)
    | .sandbox.network.deniedDomains = (((.sandbox.network.deniedDomains // []) + $hosts) | unique)' \
    --argjson deny "$AGENT_DENY" --argjson hosts "$hosts" \
    --argjson paths '["~/.local/state/desktop/clusters", "~/.kube", "~/.talos", "~/.config/desktop/clusters.conf"]'
}

# codex: its own sandbox, which writes only in the folder and has no network at all, and
# no kubeconfig. A project's .codex/config.toml is read only in a folder codex trusts, so
# the folder is marked trusted in ~/.codex/config.toml -- added once, never rewritten.
fence_codex() { # dir
  local user="${CODEX_HOME:-$HOME/.codex}/config.toml"
  mkdir -p "$1/.codex"
  if [[ ! -s $1/.codex/config.toml ]]; then
    cat >"$1/.codex/config.toml" <<'TOML'
# Written by desktop-cluster: an agent in a cluster's folder must not reach the cluster.
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = false

[shell_environment_policy]
set = { KUBECONFIG = "/dev/null" }
TOML
  fi
  command -v codex >/dev/null 2>&1 || [[ -e $user ]] || return 0
  if ! grep -qF "[projects.\"$1\"]" "$user" 2>/dev/null; then
    mkdir -p "${user%/*}"
    printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$1" >>"$user"
  fi
}

# opencode has no sandbox, only rules its own docs call best effort. So in a cluster's
# folder it may use only the providers cluster-agents.conf names -- the organisation's own
# models -- and is denied the cluster tools and the kubeconfigs on top.
fence_opencode() { # dir
  local providers
  providers=$(agent_setting opencode-providers | tr ', ' '\n\n' | grep -v '^$' | jq -R . | jq -sc .)
  merge_json "$1/opencode.json" '
    .["$schema"] = "https://opencode.ai/config.json"
    | .enabled_providers = $providers
    | .permission.bash = ((.permission.bash // {"*": "allow"}) + $bash)
    | .permission.read = ((.permission.read // {"*": "allow"}) + $read)' \
    --argjson providers "$providers" \
    --argjson bash '{"oc *": "deny", "kubectl *": "deny", "kubecolor *": "deny", "ocl *": "deny",
      "desktop-cluster *": "deny", "k9s *": "deny", "argo9s *": "deny", "talosctl *": "deny",
      "kubie *": "deny", "kubens *": "deny", "kubectx *": "deny", "argocd *": "deny"}' \
    --argjson read '{"~/.local/state/desktop/clusters/*": "deny", "~/.kube/*": "deny",
      "~/.talos/*": "deny", "~/.config/desktop/clusters.conf": "deny"}'
}

agent_fence() { # dir
  fence_claude "$1" && fence_codex "$1" && fence_opencode "$1"
}

title() { printf '\e]0;%s\a' "$1"; }

# ------------------------------------------------------------------------------ status

# One cluster, as one line of JSON: what the dashboard and `ocl status` show.
status_json() {
  local state version="" nodes='{"nodes":0,"ready":0}' updating=false cv
  state=$(reach)
  if [[ $state == ok ]]; then
    # Counted as they come, not handed to jq whole: a real cluster's nodes are hundreds of
    # kilobytes of JSON, past what one argument may be, and the cluster was then shown as
    # misconfigured -- ocp202, the moment it was signed in to.
    nodes=$(kc --request-timeout=6s get nodes -o json 2>/dev/null | jq -c '
      def ready: [.status.conditions[]? | select(.type == "Ready" and .status == "True")] | length > 0;
      {nodes: (.items // [] | length), ready: ([.items[]? | select(ready)] | length)}' 2>/dev/null) ||
      nodes='{"nodes":0,"ready":0}'
    [[ -n $nodes ]] || nodes='{"nodes":0,"ready":0}'
    if [[ $KIND == openshift ]]; then
      cv=$(kc --request-timeout=6s get clusterversion version -o json 2>/dev/null) || cv=null
      version=$(jq -r '.status.desired.version // ""' <<<"${cv:-null}" 2>/dev/null)
      jq -e '[.status.conditions[]? | select(.type == "Progressing" and .status == "True")] | length > 0' \
        <<<"${cv:-null}" >/dev/null 2>&1 && updating=true
    else
      version=$(kc --request-timeout=6s version -o json 2>/dev/null | jq -r '.serverVersion.gitVersion // ""' 2>/dev/null)
    fi
  fi
  jq -cn --arg name "$NAME" --arg kind "$KIND" --arg reach "$state" --arg version "$version" \
    --argjson count "$nodes" --argjson updating "$updating" '
    {name: $name, kind: $kind, version: $version, updating: $updating,
     nodes: $count.nodes, ready: $count.ready}
    | .state = (if $reach == "signed-out" then "signed-out"
                elif $reach == "unreachable" then "unreachable"
                elif .nodes == 0 then "unknown"
                elif .ready < .nodes then "degraded"
                elif .updating then "updating" else "healthy" end)'
}

cmd_status() {
  local json=0 work name list=()
  [[ ${1:-} == --json ]] && { json=1; shift; }
  if ((json)) && (($# == 1)); then
    QUIET=1
    load "$1" && status_json
    return
  fi
  (($#)) && list=("$@") || mapfile -t list < <(names)
  ((${#list[@]})) || { echo "no clusters in $CONF"; return; }
  work=$(mktemp -d)
  QUIET=1
  # Asked all at once: six clusters one after the other, each with a timeout, is half a minute.
  # One written down wrong is shown as that, not left out, and does not stop the others.
  for name in "${list[@]}"; do
    { (load "$name" && status_json) 2>/dev/null ||
      jq -cn --arg name "$name" '{name: $name, kind: "", state: "misconfigured", nodes: 0, ready: 0, version: ""}'; } >"$work/$name.json" &
  done
  wait
  if ((json)); then
    cat "$work"/*.json | jq -cs 'sort_by(.name)'
  else
    cat "$work"/*.json | jq -rs 'sort_by(.name)[] |
      [.name, .kind, .state, (if .nodes > 0 then "\(.ready)/\(.nodes) nodes" else "" end), .version] | @tsv' |
      table
  fi
  rm -rf "$work"
}

cmd_list() {
  entries | while IFS=$'\t' read -r name kind rest; do
    where=$(grep -oE '(server|ssh|talosconfig|kubeconfig)=[^ ]+' <<<"$rest" | head -1)
    printf '%s\t%s\t%s\n' "$name" "$kind" "${where#*=}"
  done | table
}

# ------------------------------------------------------------------------------ choosing

pick() {
  local all
  all=$(names)
  [[ -n $all ]] || die "no clusters yet: add them to $CONF (ocl edit)"
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
    cmd_list | fzf --prompt 'cluster> ' --height 40% --reverse | awk '{ print $1 }'
  elif command -v desktop-menu-select >/dev/null 2>&1; then
    desktop-menu-select --prompt "Cluster" <<<"$all"
  else
    select name in $all; do echo "$name"; break; done
  fi
}

cmd_edit() {
  mkdir -p "$(dirname "$CONF")"
  [[ -f $CONF ]] || sed -n '/^# The clusters are listed/,/^#   kind /p' "$0" | sed 's/^# \{0,1\}/# /' >"$CONF"
  exec "${EDITOR:-nvim}" "$CONF"
}

# ------------------------------------------------------------------------------ main

action=shell
case "${1:-}" in
-h | --help | help) usage; exit 0 ;;
list) cmd_list; exit ;;
names) names; exit ;;
status) shift; cmd_status "$@"; exit ;;
edit) cmd_edit ;;
login) [[ -n ${2:-} ]] || die "usage: $ME login NAME"; load "$2"; login; exit ;;
logout)
  [[ -n ${2:-} ]] || die "usage: $ME logout NAME"
  load "$2"
  if [[ $KIND == openshift && -s $FILE ]]; then oc --kubeconfig "$FILE" logout >/dev/null 2>&1 || true; fi
  rm -f "$FILE" && status_stale signed-out && echo "Signed out of $NAME"
  # Its tmux session goes too. Everything in it -- the kubie shell, k9s, argo9s -- held a
  # copy of the token just revoked, so it all stopped working while still looking signed
  # in: the prompt kept its cluster, and a sign-out seemed to have done nothing. Last, since
  # run from inside that session this is the end of the shell that ran it.
  if tmux has-session -t "=$NAME" 2>/dev/null; then
    tmux kill-session -t "=$NAME"
  fi
  exit
  ;;
session) action=session; shift ;;
-k) action=k9s; shift ;;
-a) action=argo; shift ;;
-c) action=console; shift ;;
-t) action=talos; shift ;;
-x) action=exec; shift ;;
-e) action=env; shift ;;
-*) die "unknown option $1 (see $ME --help)" ;;
esac

name=${1:-}
[[ -n $name ]] || name=$(pick)
[[ -n $name ]] || exit 0
[[ $RESERVED == *" $name "* ]] && die "'$name' is a command, not a cluster"
shift 2>/dev/null || true
load "$name"

case "$action" in
session)
  # What prefix + f is for a repository, for a cluster: a tmux session of its own, named
  # after it, with a shell, k9s and Argo CD's applications (argo9s) on it. Signed in to
  # here, first, so the windows do not each open a browser to sign in; and only made once,
  # after that it is gone to.
  ensure
  self=$(readlink -f "$0")
  if ! tmux has-session -t "=$NAME" 2>/dev/null; then
    dir="$AGENT_HOME/$NAME"
    mkdir -p "$dir"
    agent_fence "$dir" || die "could not write the agent's settings in $dir"
    shell=$(tmux new-session -d -s "$NAME" -n shell -c "$dir" -P -F '#{pane_id}' \
      "$self $(printf %q "$NAME")")
    # The shell is the window's terminal, so prefix + t in it adds a terminal as a tab, as
    # it does under a repository's editor -- and each tab another shell on this cluster,
    # not a plain one that is on none. See desktop-terminal-tabs.
    tmux set-option -p -t "$shell" @term_pane 1
    tmux set-option -p -t "$shell" @term_command "$self $(printf %q "$NAME")"
    # What desktop-tmux-restore leaves out: a cluster's session is made by this, signing in
    # first, and not rebuilt at login as a shell that is on no cluster.
    tmux set-option -t "=$NAME:" @cluster "$NAME"
    tmux new-window -d -t "=$NAME:" -n k9s -c "$dir" "$self -k $(printf %q "$NAME")"
    if command -v argo9s >/dev/null 2>&1; then
      tmux new-window -d -t "=$NAME:" -n argo -c "$dir" "$self -a $(printf %q "$NAME")"
    fi
    if command -v desktop-agent-layout >/dev/null 2>&1; then
      desktop-agent-layout --column "=$NAME:shell" claude >/dev/null 2>&1 || true
    fi
  fi
  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$NAME"
  else
    tmux attach-session -t "=$NAME"
  fi
  ;;
shell)
  ensure
  environment
  title "$NAME · $KIND"
  # kubie's shell when it is there, as the old ocl's was: it works on a copy of the
  # cluster's kubeconfig, so `kubie ns` -- fzf over the namespaces when it is given none --
  # moves this shell only. kubens would write the namespace into the file itself, which
  # the k9s beside it in `ocl session` reads too.
  if command -v kubie >/dev/null 2>&1; then
    echo "$NAME ($KIND): a kubie shell; kubie ns for a namespace, exit to leave"
    # kubie starts the shell it finds as its parent, and fails ("No such file or directory")
    # when that is not a shell -- a terminal opened from the menu or the dashboard runs this
    # directly. So it is started from $SHELL, which is then the one it gives you. The names
    # go in the environment: "$X" reads the same in fish as in bash. "; true" because bash
    # replaces itself with a -c command that is a single one, and kubie is orphaned again.
    DESKTOP_KUBIE_FILE=$FILE DESKTOP_KUBIE_NAME=$NAME \
      exec "${SHELL:-bash}" -c 'kubie ctx --kubeconfig "$DESKTOP_KUBIE_FILE" "$DESKTOP_KUBIE_NAME"; true'
  fi
  echo "$NAME ($KIND): KUBECONFIG is its own; leave with exit"
  exec "${SHELL:-bash}"
  ;;
k9s)
  command -v k9s >/dev/null 2>&1 || die "k9s is not installed"
  ensure
  environment
  title "k9s · $NAME"
  exec k9s "$@"
  ;;
argo)
  command -v argo9s >/dev/null 2>&1 || die "argo9s is not installed (install/packaging/argo9s.sh)"
  ensure
  environment
  ns=${opt_argocd:-$([[ $KIND == openshift ]] && echo openshift-gitops || echo argocd)}
  title "Argo CD · $NAME"
  if argo9s --help 2>&1 | grep -q -- '--namespace'; then
    exec argo9s --namespace "$ns" "$@"
  fi
  exec argo9s "$@"
  ;;
console)
  url=$opt_console
  if [[ -z $url && $KIND == openshift ]]; then
    ensure >&2
    url=$(oc --kubeconfig "$FILE" whoami --show-console 2>/dev/null)
  fi
  [[ -n $url ]] || die "$NAME has no console: set console= in $CONF"
  xdg-open "$url" >/dev/null 2>&1 &
  disown
  ;;
talos)
  [[ $KIND == talos ]] || die "$NAME is $KIND, not talos"
  command -v talosctl >/dev/null 2>&1 || die "talosctl is not installed (desktop-update-releases talosctl)"
  environment
  mapfile -t targs < <(talos_args)
  (($#)) && targs+=(--nodes "$(IFS=,; echo "$*")")
  title "talos · $NAME"
  exec talosctl "${targs[@]}" dashboard
  ;;
exec)
  (($#)) || die "usage: $ME -x NAME COMMAND..."
  ensure >&2
  environment
  exec "$@"
  ;;
env)
  # Plain `export` lines: bash and zsh eval them, and fish has an export that takes them.
  printf 'export KUBECONFIG=%q\nexport DESKTOP_CLUSTER=%q\n' "$FILE" "$NAME"
  [[ $KIND == talos && -n $opt_talosconfig ]] && printf 'export TALOSCONFIG=%q\n' "$opt_talosconfig"
  [[ -s $FILE ]] || echo "$ME: not signed in to $NAME yet: ocl login $NAME" >&2
  ;;
esac
