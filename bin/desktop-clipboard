#!/usr/bin/env bash

# desktop-clipboard: what was copied before the last thing that was copied.
#
#   desktop-clipboard pick     # SUPER + V: choose from the history, and it is on the clipboard
#   desktop-clipboard delete   # SUPER + SHIFT + V: choose one entry, and it is forgotten
#   desktop-clipboard clear    # forget all of it
#   desktop-clipboard watch    # the watcher, started at login
#   desktop-clipboard store    # what the watcher runs for each copy; reads it on stdin
#
# A Wayland clipboard holds one thing, and holds it only while the program that offered it
# is running: copy a second thing and the first is gone, close the terminal and so is what
# came out of it. cliphist keeps what passes through -- text and images -- and this is the
# part around it: what must never be kept, and choosing from what was.
#
# Never kept: anything a password manager copied. KeePassXC marks what it puts on the
# clipboard with the x-kde-passwordManagerHint type, precisely so that a history like this
# one can leave it alone, and clears the clipboard itself a few seconds later. A history
# that kept it would be a plain-text list of every password used since login.
#
# Choosing is done in the launcher's own list, so it looks and searches like everything
# else there. The chosen entry is put on the clipboard, not typed: what Ctrl+V means
# differs between a terminal and everything else, and guessing wrong pastes into the wrong
# place.

set -uo pipefail

SECRET_HINT="x-kde-passwordManagerHint"

die() {
  echo "desktop-clipboard: $1" >&2
  exit 1
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }

# Asked of the clipboard as it is now, which is the copy this was started for: wl-paste
# runs this the moment an offer arrives. Anything that cannot be established counts as
# secret -- the worse mistake is the one that keeps a password.
secret() {
  local types
  types=$(wl-paste --list-types 2>/dev/null) || return 0
  grep -qxF "$SECRET_HINT" <<<"$types"
}

cmd_store() {
  if secret; then
    cat >/dev/null
    return 0
  fi
  need cliphist
  cliphist store
}

# One watcher for text and one for images: asked for both at once, wl-paste hands over
# whichever type the source lists first, and a browser lists text/html before the image.
cmd_watch() {
  need cliphist
  need wl-paste
  wl-paste --type text --watch "$0" store &
  wl-paste --type image --watch "$0" store &
  wait
}

# A small copy of each image, so the list can show the picture rather than say that there
# is one: "Image 1920x1080" names six screenshots the same. Made once and kept for the
# session, in a directory nobody else can read -- a screenshot is as private as the text.
THUMBS="${XDG_RUNTIME_DIR:-/tmp}/desktop/clipboard"

thumbnail() { # id -> path, or nothing when one cannot be made
  local path="$THUMBS/$1.png"
  if [[ ! -s $path ]]; then
    (umask 077 && mkdir -p "$THUMBS") || return 1
    cliphist decode "$1" 2>/dev/null | magick - -thumbnail 96x96 "png:$path" 2>/dev/null
    [[ -s $path ]] || {
      rm -f "$path"
      return 1
    }
  fi
  echo "$path"
}

# cliphist's list is "id<TAB>preview". The id is what it decodes by and means nothing to
# anyone, so it is kept here and the preview is what is shown; an image's preview is
# cliphist's own description of it, "[[ binary data 14 KiB png 640x480 ]]", turned into
# something that reads like a line of a menu.
menu_lines() { # stdin: cliphist list -> "id<TAB>line for desktop-menu-select"
  local id preview kind size shape picture pictures=0
  while IFS=$'\t' read -r id preview; do
    [[ -n $id ]] || continue
    if [[ $preview =~ ^\[\[\ binary\ data\ (.+)\ ([a-z0-9]+)\ ([0-9]+x[0-9]+)\ \]\]$ ]]; then
      size=${BASH_REMATCH[1]} kind=${BASH_REMATCH[2]} shape=${BASH_REMATCH[3]}
      # A path where the glyph goes is a picture to the launcher. The most recent ones
      # only: every one is a decode, and the list is waited for.
      picture=""
      if ((pictures < 24)); then
        picture=$(thumbnail "$id") && pictures=$((pictures + 1))
      fi
      printf '%s\t%s\tImage %s\t%s · %s\n' "$id" "${picture:-󰋩}" "$shape" "$kind" "$size"
    else
      # A tab in the text would be read as the end of the label.
      printf '%s\t󰅍\t%s\n' "$id" "${preview//$'\t'/ }"
    fi
  done
}

# The id of the entry chosen in the launcher's list, or nothing.
choose() { # prompt
  local listing chosen id
  need cliphist
  listing=$(cliphist list 2>/dev/null | menu_lines)
  if [[ -z $listing ]]; then
    notify-send -a "Clipboard" "Clipboard history is empty" "Nothing has been copied since it was started." 2>/dev/null
    return 1
  fi
  # Pictures of entries that are no longer in the history go with them.
  if [[ -d $THUMBS ]]; then
    for chosen in "$THUMBS"/*.png; do
      [[ -e $chosen ]] || continue
      id=$(basename "$chosen" .png)
      grep -q "^$id	" <<<"$listing" || rm -f "$chosen"
    done
  fi
  chosen=$(cut -f2- <<<"$listing" | desktop-menu-select --prompt "$1" --width 720 --rows 12) || return 1
  # What comes back is the line without its glyph. Two entries can read the same -- long
  # texts that begin alike -- and then it is the more recent one, which is listed first.
  id=$(awk -F '\t' -v want="$chosen" '{ line = $3; if (NF > 3) line = line "\t" $4 } line == want { print $1; exit }' <<<"$listing")
  [[ -n $id ]] || return 1
  echo "$id"
}

cmd_pick() {
  local id
  id=$(choose "Clipboard") || return 0
  cliphist decode "$id" | wl-copy
}

# One entry, for the copy that should not have been kept: a token pasted through the
# clipboard by a program that does not mark it secret. cliphist deletes by the line it
# listed, so that line is handed back to it.
cmd_delete() {
  local id
  id=$(choose "Forget from clipboard history") || return 0
  cliphist list 2>/dev/null | awk -F '\t' -v id="$id" '$1 == id' | cliphist delete
  rm -f "$THUMBS/$id.png"
}

cmd_clear() {
  need cliphist
  cliphist wipe
  rm -rf "$THUMBS"
}

case "${1:-}" in
pick) cmd_pick ;;
delete) cmd_delete ;;
clear) cmd_clear ;;
watch) cmd_watch ;;
store) cmd_store ;;
menu-lines) menu_lines ;;
*) die "usage: desktop-clipboard pick|delete|clear|watch|store" ;;
esac
