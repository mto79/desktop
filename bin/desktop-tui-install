#!/usr/bin/env bash

if [ "$#" -ne 4 ]; then
  echo -e "\e[32mLet's create a TUI shortcut you can start with the app launcher.\n\e[0m"
  APP_NAME=$(gum input --prompt "Name> " --placeholder "My TUI")
  APP_EXEC=$(gum input --prompt "Launch Command> " --placeholder "lazydocker or bash -c 'dust; read -n 1 -s'")
  WINDOW_STYLE=$(gum choose --header "Window style" float tile)
  ICON_SOURCE=$(gum input --prompt "Icon> " --placeholder "PNG URL (see https://dashboardicons.com) or a local PNG path")
else
  APP_NAME="$1"
  APP_EXEC="$2"
  WINDOW_STYLE="$3"
  ICON_SOURCE="$4"
fi

if [[ -z "$APP_NAME" || -z "$APP_EXEC" || -z "$ICON_SOURCE" ]]; then
  echo "You must set app name, app command, and icon!"
  exit 1
fi

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_PATH="$ICON_DIR/$APP_NAME.png"

mkdir -p "$ICON_DIR"

# The icon may be a URL or a local file: install/packaging/tuis.sh reinstalls entries
# whose icon already lives in ICON_DIR, and -ef catches exactly that case, where the
# copy would be a file onto itself.
if [[ -f "$ICON_SOURCE" ]]; then
  if [[ ! "$ICON_SOURCE" -ef "$ICON_PATH" ]]; then
    cp -- "$ICON_SOURCE" "$ICON_PATH"
  fi
else
  # Download to a temp file and move it into place only on success. `curl -o` truncates
  # its target before it knows whether the transfer will work, so downloading straight
  # to ICON_PATH turns a dead link or an offline install into a blanked-out icon that
  # was previously fine. -f makes an HTTP error a failure rather than a 404 page saved
  # as a PNG.
  ICON_TMP=$(mktemp)
  if curl -fsSL -o "$ICON_TMP" "$ICON_SOURCE"; then
    mv -- "$ICON_TMP" "$ICON_PATH"
  else
    rm -f "$ICON_TMP"
    echo "Error: Failed to download icon from $ICON_SOURCE."
    [[ -f "$ICON_PATH" ]] && echo "Keeping the existing $ICON_PATH."
  fi
fi

if [[ $WINDOW_STYLE == "float" ]]; then
  APP_CLASS="TUI.float"
else
  APP_CLASS="TUI.tile"
fi

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=ghostty --title=$APP_CLASS -e $APP_EXEC
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
EOF

chmod +x "$DESKTOP_FILE"

if [ "$#" -ne 4 ]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"
fi
