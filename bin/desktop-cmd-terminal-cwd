#!/usr/bin/env bash

# The folder a new terminal should open in: the one the focused terminal's shell is in,
# and home for anything else. The first child of a browser or an editor is one of its
# own helpers, whose folder means nothing to the person pressing the key -- often /.
# Ghostty is the only terminal, and it always has the same class.
window=$(hyprctl activewindow -j 2>/dev/null)
class=$(jq -r '.class // ""' <<<"$window" 2>/dev/null)
terminal_pid=$(jq -r '.pid // ""' <<<"$window" 2>/dev/null)

if [[ $class == com.mitchellh.ghostty && -n $terminal_pid ]]; then
  shell_pid=$(pgrep -P "$terminal_pid" | head -n1)
fi

if [[ -n ${shell_pid:-} ]] && cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null) && [[ -d $cwd ]]; then
  echo "$cwd"
else
  echo "$HOME"
fi
