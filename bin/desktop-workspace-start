#!/usr/bin/env bash

# desktop-workspace-start: open the day's windows at login, each on its own workspace.
#
#   1  Brave
#   2  the chat, Teams
#   3  tmux, attached to "home", with "llm-wiki" beside it under claude
#   4  KeePassXC
#   5  Obsidian
#   6  the dashboard -- the shell's own window, already there; this is where the login ends
#
# Which screen each of those workspaces sits on is desktop-workspace-pin's decision, so
# it runs first; this script only decides what opens where.
#
# Each window is moved once it has mapped, rather than placed by a `[workspace N]` exec
# rule. Those rules follow the process Hyprland spawned, and here that is often not the
# one that draws the window: the AppImages re-exec, and a Brave web app belongs to
# whichever Brave process came up first. They were unreliable in practice -- one login
# put tmux on workspace 2 and Brave on 3. A window is recognised as the launch's own by
# being a new address of the expected class, so windows of one class open one at a time.

set -euo pipefail

TIMEOUT="${DESKTOP_WORKSPACE_START_TIMEOUT:-60}"
LLM_WIKI="$HOME/Data/MTO/Documents/llm-wiki"

# Which chat is this machine's to know, not the repository's: see desktop-launch-chat.
CHAT_URL=""
# shellcheck source=/dev/null
[[ -f "$HOME/.config/desktop/chat.conf" ]] && source "$HOME/.config/desktop/chat.conf"
chat_host=${CHAT_URL#*://}
chat_host=${chat_host%%/*}

addresses_of() {
  hyprctl clients -j | jq -r --arg class "$1" '.[] | select(.class == $class) | .address' | sort
}

# open_on <workspace> <class> <command...>
open_on() {
  local workspace="$1" class="$2" before address deadline
  shift 2

  before="$(addresses_of "$class")"
  setsid "$@" </dev/null >/dev/null 2>&1 &

  deadline=$((SECONDS + TIMEOUT))
  while ((SECONDS < deadline)); do
    address="$(comm -13 <(echo "$before") <(addresses_of "$class") | grep . | head -1 || true)"
    if [[ -n "$address" ]]; then
      hyprctl dispatch movetoworkspacesilent "$workspace,address:$address" >/dev/null
      return 0
    fi
    sleep 0.2
  done

  # Not fatal: one app that fails to start is no reason to leave the rest unopened.
  echo "desktop-workspace-start: no $class window within ${TIMEOUT}s" >&2
  notify-send -u critical "Workspaces" "$class did not open a window for workspace $workspace" || true
}

desktop-workspace-pin

# While the windows open, an application asking for attention does not get the focus.
# Hyprland otherwise follows such a request to whatever workspace the window is on
# (misc:focus_on_activate), and applications ask when they have finished starting -- which
# is after this script has put the focus where it should end. Obsidian asks last, so every
# login ended on workspace 5 whatever was dispatched here. Put back as it was at the end,
# and on any way out, so a script that dies half-way does not leave it off.
activate=true
[[ $(hyprctl getoption misc:focus_on_activate 2>/dev/null) == *"int: 0"* ]] && activate=false
restore_activate() { hyprctl keyword misc:focus_on_activate "$activate" >/dev/null 2>&1 || true; }
trap restore_activate EXIT
hyprctl keyword misc:focus_on_activate false >/dev/null 2>&1 || true

# Both sessions exist before the terminal attaches, so llm-wiki is one switch away --
# and llm-wiki is the one that is always the same job, so it is laid out and has claude
# up by the time it is switched to. home is left a plain shell; what it is for varies.
tmux has-session -t "=home" 2>/dev/null || tmux new-session -d -s home -c "$HOME"
if ! tmux has-session -t "=llm-wiki" 2>/dev/null; then
  tmux new-session -d -s llm-wiki -n ide -c "$LLM_WIKI"
  desktop-agent-layout llm-wiki:ide claude
fi

# Then whatever else was open before the machine went down: the other repositories'
# sessions, the tabs in each AI column, the tasks they were on. Only what is missing is
# built, so the two sessions above are left as they are. Not waited for -- it takes a few
# seconds a window, and the terminal below should not open late for it.
desktop-tmux-restore restore >/dev/null 2>&1 &

# Every launch here has a class of its own bar the Brave ones, which share a browser
# process, so those go in turn and the rest start together.
{
  open_on 1 brave-browser uwsm app -- brave-browser
  if [[ -n $CHAT_URL ]]; then
    open_on 2 "brave-${chat_host}__-Default" desktop-launch-webapp "$CHAT_URL"
  fi
  open_on 2 brave-teams.microsoft.com__-Default desktop-launch-webapp "https://teams.microsoft.com"
} &
open_on 3 com.mitchellh.ghostty uwsm app -- ghostty -e tmux attach-session -t home &
open_on 4 org.keepassxc.KeePassXC "$HOME/.local/bin/KeePassXC.AppImage" &
open_on 5 md.obsidian.Obsidian "$HOME/.local/bin/Obsidian.AppImage" &
wait

# Show the first workspace of every screen, and leave the focus on workspace 6: the day
# starts on the dashboard, which says what is waiting before anything is opened to find
# out. Screens that hold several of these show the last one named, which is why 6 comes
# last -- and 1 just before it, so that it is what the laptop falls back to.
hyprctl --batch "dispatch workspace 5 ; dispatch workspace 4 ; dispatch workspace 2 ; dispatch workspace 3 ; dispatch workspace 1 ; dispatch workspace 6" >/dev/null

# And a welcome, now that everything is where it belongs: a greeting by name and what is
# waiting, said while the dashboard shows the same. Not waited for, and desktop-say keeps
# quiet by itself when it is switched off or do-not-disturb is on.
desktop-brief --welcome >/dev/null 2>&1 &

# The late askers get a moment to ask and be ignored before asking counts again.
sleep "${DESKTOP_WORKSPACE_START_SETTLE:-3}"
